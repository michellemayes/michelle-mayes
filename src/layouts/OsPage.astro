---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Window from '../components/Window.astro';

/**
 * Shell for every page except the homepage: menu bar, a single app window
 * on the desktop wallpaper, and the dock.
 */
interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>;
  windowTitle: string;
  meta?: string;
  size?: 'dialog' | 'm' | 'l' | 'xl';
}

const { title, description, jsonLd, windowTitle, meta, size = 'l' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} jsonLd={jsonLd} />
  </head>
  <body>
    <Header />
    <main id="main-content" class:list={['stage', `stage-${size}`]}>
      <Window title={windowTitle} titleAs="p" meta={meta} closeHref="/" class="page-window">
        <slot name="toolbar" slot="toolbar" />
        <slot />
      </Window>
      <p class="desk-note">&copy; {new Date().getFullYear()} Michelle Mayes · Made in Austin with Astro, coffee, and too many side projects.</p>
    </main>
    <Footer floating />
  </body>
</html>

<style>
  .stage {
    width: calc(100% - 32px);
    margin: 28px auto 0;
  }

  /* Lets the app window morph between pages during view transitions. */
  .stage :global(.page-window) {
    view-transition-name: app-window;
  }

  /* The dock is pinned to the bottom on wide screens, so leave room for it. */
  @media (min-width: 1100px) {
    .stage {
      padding-bottom: 120px;
    }
  }

  .desk-note {
    margin-top: 14px;
    font-size: 12px;
    text-align: center;
    color: rgba(31, 29, 43, 0.6);
  }

  @media (max-width: 1099px) {
    .desk-note {
      display: none;
    }
  }

  .stage-dialog { max-width: 460px; margin-top: 12vh; }
  .stage-m { max-width: 820px; }
  .stage-l { max-width: 1080px; }
  .stage-xl { max-width: 1240px; }

  @media (max-width: 560px) {
    .stage {
      width: calc(100% - 24px);
      margin-top: 14px;
    }

    .stage-dialog {
      margin-top: 8vh;
    }
  }
</style>
