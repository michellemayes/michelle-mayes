---
import type { GitHubStats } from '../lib/stats';

interface Props {
  stats: GitHubStats;
  currentlyBuilding?: { name: string; url: string } | null;
}

const { stats, currentlyBuilding = null } = Astro.props;

const statItems = [
  { value: stats.totalRepos, label: 'Projects', suffix: '' },
  { value: stats.recentActivity, label: 'Updated This Month', suffix: '' },
  { value: stats.primaryLanguagePercent, label: stats.primaryLanguage, suffix: '%' },
  { value: stats.avgDaysToShip || '—', label: 'Avg Days to Ship', suffix: stats.avgDaysToShip ? 'd' : '' },
].filter((stat) => stat.value !== 0 && stat.value !== '—');
---

<section class="hero-stats">
  <div class="hero-doodles" aria-hidden="true">
    <span class="blob blob-violet"></span>
    <span class="blob blob-amber"></span>
    <span class="doodle d1"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.2 7.8L22 12l-7.8 2.2L12 22l-2.2-7.8L2 12l7.8-2.2z"/></svg></span>
    <span class="doodle d2"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.2 7.8L22 12l-7.8 2.2L12 22l-2.2-7.8L2 12l7.8-2.2z"/></svg></span>
    <span class="doodle d3"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.2 7.8L22 12l-7.8 2.2L12 22l-2.2-7.8L2 12l7.8-2.2z"/></svg></span>
    <span class="doodle d4"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-dasharray="3 3"><circle cx="12" cy="12" r="9"/></svg></span>
  </div>
  <div class="hero-content">
    {currentlyBuilding && (
      <a class="now-pill" href={currentlyBuilding.url} target="_blank" rel="noopener noreferrer">
        <span class="now-dot" aria-hidden="true"></span>
        Currently tinkering on <strong>{currentlyBuilding.name}</strong>
      </a>
    )}
    <div class="avatar-wrapper">
      <div class="avatar-glow"></div>
      <img
        src="/avatar.jpg"
        alt="Michelle Mayes"
        class="avatar"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </div>
    <h1 class="hero-name">
      Michelle Mayes
      <svg class="squiggle" viewBox="0 0 300 16" preserveAspectRatio="none" aria-hidden="true">
        <path d="M2 10 C 40 2, 70 16, 110 8 S 180 2, 220 9 S 280 14, 298 6" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" />
      </svg>
    </h1>
    <p class="hero-tagline">I ship fast. AI keeps up.</p>
    <p class="hero-subline">
      Product-minded full-stack builder making practical AI tools, cozy Mac apps, and the
      occasional grocery robot. Always with measurable outcomes.
    </p>

    <div class="hero-cta">
      <a href="#showcase-title" class="hero-link primary">
        See the open source
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
      </a>
      <a href="/resume" class="hero-link secondary">View Resume</a>
    </div>

    <div class="stats-ribbon">
      {statItems.map((stat, index) => (
        <div class="stat-item" style={`--stat-index: ${index}`}>
          <span
            class="stat-value"
            data-count-to={typeof stat.value === 'number' ? stat.value : undefined}
            data-suffix={stat.suffix}
          >
            {stat.value}{stat.suffix}
          </span>
          <span class="stat-label">{stat.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // Count-up animation for stat values
  const countElements = document.querySelectorAll('[data-count-to]');

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && countElements.length > 0) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const el = entry.target as HTMLElement;
          const target = parseInt(el.dataset.countTo || '0', 10);
          const suffix = el.dataset.suffix || '';
          if (isNaN(target)) return;

          const duration = 800;
          const start = performance.now();

          function update(now: number) {
            const elapsed = now - start;
            const progress = Math.min(elapsed / duration, 1);
            // Ease-out cubic
            const eased = 1 - Math.pow(1 - progress, 3);
            const current = Math.round(eased * target);
            el.textContent = `${current}${suffix}`;
            if (progress < 1) requestAnimationFrame(update);
          }

          requestAnimationFrame(update);
          observer.unobserve(el);
        }
      });
    }, { threshold: 0.5 });

    countElements.forEach((el) => observer.observe(el));
  }

  // Console easter egg for developer visitors
  console.log(
    '%c👋 Hey there, curious dev!',
    'font-size: 16px; font-weight: bold; color: #8B5CF6;'
  );
  console.log(
    '%cThis portfolio is built with Astro, ships daily via GitHub Actions, and pulls live data from GitHub.\nLike what you see? Let\'s chat → https://calendar.app.google/yYSHV4KQ4zJsxkdt5',
    'font-size: 12px; color: #6B6876;'
  );

</script>

<style>
  .hero-stats {
    text-align: center;
    padding: var(--space-3xl) 0;
    position: relative;
  }

  /* Background doodles */
  .hero-doodles {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
    opacity: 0.35;
  }

  .blob-violet {
    width: 320px;
    height: 320px;
    background: var(--accent-200);
    top: 18%;
    left: 8%;
    animation: drift 14s ease-in-out infinite;
  }

  .blob-amber {
    width: 260px;
    height: 260px;
    background: var(--warm-100);
    bottom: 10%;
    right: 8%;
    animation: drift 18s ease-in-out infinite reverse;
  }

  .doodle {
    position: absolute;
    color: var(--accent-300);
    animation: float 6s ease-in-out infinite;
  }

  .doodle svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .d1 { top: 14%; left: 18%; width: 22px; height: 22px; }
  .d2 { top: 22%; right: 16%; width: 26px; height: 26px; color: var(--warm-light); opacity: 0.6; animation-delay: 1.5s; }
  .d3 { bottom: 30%; left: 10%; width: 16px; height: 16px; animation-delay: 3s; }
  .d4 { bottom: 18%; right: 22%; width: 22px; height: 22px; animation-delay: 2s; }

  @keyframes drift {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(30px, 20px); }
  }

  @keyframes float {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-10px) rotate(12deg); }
  }

  /* "Currently tinkering" pill */
  .now-pill {
    display: flex;
    width: fit-content;
    margin-inline: auto;
    align-items: center;
    gap: 8px;
    min-height: 36px;
    padding: 4px 14px;
    margin-bottom: var(--space-lg);
    font-size: var(--text-sm);
    color: var(--text-muted);
    background: var(--bg-card);
    border: 1px solid var(--accent-100);
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    opacity: 0;
    animation: fade-up 0.6s ease-out 0.1s forwards;
  }

  .now-pill strong {
    color: var(--text);
  }

  .now-pill:hover {
    color: var(--text);
    border-color: var(--accent-300);
  }

  .now-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--leaf);
    box-shadow: 0 0 0 0 rgba(22, 163, 74, 0.5);
    animation: ping 2s ease-out infinite;
  }

  @keyframes ping {
    0% { box-shadow: 0 0 0 0 rgba(22, 163, 74, 0.5); }
    80%, 100% { box-shadow: 0 0 0 8px rgba(22, 163, 74, 0); }
  }

  .squiggle {
    display: block;
    width: min(70%, 320px);
    height: 14px;
    margin: 2px auto 0;
    color: var(--warm-light);
    stroke-dasharray: 360;
    stroke-dashoffset: 360;
    animation: draw 1s ease-out 0.8s forwards;
  }

  @keyframes draw {
    to { stroke-dashoffset: 0; }
  }

  .hero-content {
    position: relative;
    z-index: 1;
  }

  /* Avatar */
  .avatar-wrapper {
    position: relative;
    display: inline-block;
    margin-bottom: var(--space-lg);
  }

  .avatar-glow {
    position: absolute;
    inset: -6px;
    background: var(--accent);
    border-radius: 50%;
    opacity: 0.4;
    filter: blur(20px);
    animation: glow-pulse 3s ease-in-out infinite;
    z-index: 0;
    transition: background 0.6s ease;
  }

  .avatar-wrapper:hover .avatar-glow {
    background: var(--warm);
  }

  @keyframes glow-pulse {
    0%, 100% { opacity: 0.3; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(1.05); }
  }

  .avatar {
    position: relative;
    width: 160px;
    height: 160px;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid var(--bg);
    box-shadow: var(--shadow-colored-lg);
    z-index: 1;
    transition: transform 0.4s ease-out;
  }

  .avatar-wrapper:hover .avatar {
    transform: scale(1.03);
  }

  /* Name & Tagline */
  .hero-name {
    font-family: var(--font-serif);
    font-size: var(--text-fluid-5xl);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    color: var(--text);
    margin: 0 0 var(--space-sm) 0;
    opacity: 0;
    animation: fade-up 0.6s ease-out 0.2s forwards;
  }

  .hero-tagline {
    font-size: var(--text-fluid-xl);
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    color: var(--text-muted);
    margin: 0 0 var(--space-sm) 0;
    opacity: 0;
    animation: fade-up 0.6s ease-out 0.4s forwards;
  }

  .hero-subline {
    max-width: 680px;
    margin: 0 auto var(--space-lg) auto;
    color: var(--text-muted);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    opacity: 0;
    animation: fade-up 0.6s ease-out 0.5s forwards;
  }

  .hero-cta {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-2xl);
    opacity: 0;
    animation: fade-up 0.6s ease-out 0.6s forwards;
  }

  .hero-link {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.65rem 1rem;
    border-radius: 10px;
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    gap: 6px;
    border: 1px solid transparent;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .hero-link.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: white;
  }

  .hero-link.primary:hover {
    background: var(--accent-dark);
    border-color: var(--accent-dark);
    color: white;
  }

  .hero-link.secondary {
    background: var(--accent-50);
    border-color: var(--accent-200);
    color: var(--accent-dark);
  }

  .hero-link.secondary:hover {
    background: var(--accent-100);
    color: var(--accent-dark);
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Stats Ribbon */
  .stats-ribbon {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-xl);
    flex-wrap: wrap;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 var(--space-lg);
    border-right: 1px solid var(--accent-100);
    opacity: 0;
    animation: fade-up 0.5s ease-out forwards;
    animation-delay: calc(0.6s + var(--stat-index) * 0.1s);
  }

  .stat-item:last-child {
    border-right: none;
  }

  .stat-value {
    font-family: var(--font-serif);
    font-size: var(--text-3xl);
    font-weight: 700;
    color: var(--accent);
    line-height: 1;
    margin-bottom: var(--space-xs);
    font-variant-numeric: tabular-nums;
  }

  .stat-label {
    font-size: var(--text-xs);
    color: var(--text-muted);
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  /* Mobile */
  @media (max-width: 768px) {
    .avatar {
      width: 120px;
      height: 120px;
    }

    .hero-subline {
      font-size: var(--text-sm);
      max-width: 560px;
      padding: 0 var(--space-md);
    }

    .stats-ribbon {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-md);
      padding: 0 var(--space-md);
    }

    .stat-item {
      padding: var(--space-md);
      border-right: none;
      background: var(--bg-card);
      border-radius: 12px;
      box-shadow: var(--shadow-sm);
    }

    .stat-value {
      font-size: var(--text-2xl);
    }
  }

  @media (max-width: 480px) {
    .hero-stats {
      padding: var(--space-lg) 0 var(--space-2xl);
    }

    .avatar {
      width: 100px;
      height: 100px;
    }

    .hero-cta {
      flex-direction: column;
      padding: 0 var(--space-md);
    }

    .hero-link {
      width: 100%;
      max-width: 260px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .blob,
    .doodle,
    .now-dot {
      animation: none;
    }

    .squiggle {
      animation: none;
      stroke-dashoffset: 0;
    }

    .now-pill,
    .avatar-glow,
    .hero-name,
    .hero-tagline,
    .hero-subline,
    .hero-cta,
    .stat-item {
      animation: none;
      opacity: 1;
    }

    .avatar-wrapper:hover .avatar {
      transform: none;
    }
  }
</style>
