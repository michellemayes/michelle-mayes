---
import { DESIGN_OPTIONS, getDesignNeighbors } from '../../lib/design-data';

interface Props {
  slug: string;
  placement?: 'bottom' | 'top';
}

const { slug, placement = 'bottom' } = Astro.props;
const { index, current, prev, next } = getDesignNeighbors(slug);
---

<nav class:list={['design-switcher', `ds-${placement}`]} aria-label="Design options">
  <a href={`/designs/${prev.slug}`} class="ds-arrow" aria-label={`Previous: ${prev.name}`}>&larr;</a>
  <a href="/designs" class="ds-label">
    <span class="ds-count">{index + 1}/{DESIGN_OPTIONS.length}</span>
    <span class="ds-name">{current.name}</span>
  </a>
  <a href={`/designs/${next.slug}`} class="ds-arrow" aria-label={`Next: ${next.name}`}>&rarr;</a>
</nav>

<script>
  document.addEventListener('keydown', (event) => {
    const target = event.target as HTMLElement | null;
    if (target && (target.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName))) return;
    if (event.metaKey || event.ctrlKey || event.altKey) return;
    const arrows = document.querySelectorAll<HTMLAnchorElement>('.design-switcher .ds-arrow');
    if (event.key === 'ArrowLeft') arrows[0]?.click();
    if (event.key === 'ArrowRight') arrows[1]?.click();
  });
</script>

<style>
  .design-switcher {
    position: fixed;
    left: 50%;
    bottom: 16px;
    transform: translateX(-50%);
    z-index: 9999;
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 4px;
    background: rgba(20, 18, 28, 0.88);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 999px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
    font: 500 13px/1 system-ui, -apple-system, sans-serif;
    color: #fff;
    max-width: calc(100vw - 32px);
  }

  .design-switcher a {
    color: inherit;
    text-decoration: none;
    border-radius: 999px;
    transition: background-color 0.15s ease;
  }

  .design-switcher a:hover,
  .design-switcher a:focus-visible {
    background: rgba(255, 255, 255, 0.14);
  }

  .design-switcher a:focus-visible {
    outline: 2px solid #A78BFA;
    outline-offset: 2px;
  }

  /* Top placement only kicks in where the page has room for a fixed dock below. */
  @media (min-width: 1100px) {
    .ds-top {
      bottom: auto;
      top: 40px;
    }
  }

  .ds-arrow {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    font-size: 16px;
  }

  .ds-label {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 12px;
    height: 36px;
    white-space: nowrap;
  }

  .ds-count {
    font-variant-numeric: tabular-nums;
    opacity: 0.6;
  }

  @media print {
    .design-switcher { display: none; }
  }
</style>
