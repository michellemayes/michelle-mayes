---
import { SOCIAL_LINKS } from '../consts';

// Shortcuts that live on the desktop at every URL, like files and folders.
const icons = [
  { href: '/resume', label: 'Resume.pdf', kind: 'file' },
  { href: '/blog', label: 'Blog', kind: 'folder' },
  { href: '/about', label: 'About', kind: 'folder' },
  { href: SOCIAL_LINKS.linkedin, label: 'LinkedIn', kind: 'link' },
  { href: SOCIAL_LINKS.email, label: 'Say hi', kind: 'mail' },
];
---

<ul class="icons" aria-label="Desktop shortcuts">
  {icons.map((icon) => (
    <li>
      <a
        href={icon.href}
        class={`icon icon-${icon.kind}`}
        target={icon.href.startsWith('http') ? '_blank' : undefined}
        rel={icon.href.startsWith('http') ? 'noopener noreferrer' : undefined}
      >
        <span class="icon-art" aria-hidden="true"></span>
        <span class="icon-label">{icon.label}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .icons {
    position: absolute;
    top: 20px;
    right: 20px;
    z-index: 0;
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .icon {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    width: 84px;
    padding: 6px 4px;
    border-radius: 8px;
    color: var(--os-ink);
    text-align: center;
    text-decoration: none;
    font-family: var(--font-sans);
    line-height: 1.3;
  }

  .icon:hover {
    color: var(--os-ink);
  }

  .icon:active {
    transform: none;
  }

  .icon:hover .icon-label,
  .icon:focus-visible .icon-label {
    background: var(--os-blue);
    color: #FFFFFF;
    text-shadow: none;
  }

  .icon:focus-visible {
    outline: none;
  }

  .icon-art {
    position: relative;
    width: 52px;
    height: 52px;
    filter: drop-shadow(0 4px 6px rgba(31, 29, 43, 0.2));
  }

  .icon-file .icon-art {
    width: 42px;
    background: #FFFFFF;
    border-radius: 4px;
    clip-path: polygon(0 0, 70% 0, 100% 22%, 100% 100%, 0 100%);
  }

  .icon-file .icon-art::after {
    content: 'PDF';
    position: absolute;
    left: 4px;
    right: 4px;
    bottom: 8px;
    padding: 1px 0;
    background: #DC2626;
    color: #FFFFFF;
    font-size: 9px;
    font-weight: 800;
    line-height: 1.4;
    border-radius: 2px;
  }

  .icon-folder .icon-art {
    height: 40px;
    margin-top: 8px;
    background: linear-gradient(180deg, #7DD3FC, #3B82F6);
    border-radius: 3px 6px 6px 6px;
  }

  .icon-folder .icon-art::before {
    content: '';
    position: absolute;
    top: -6px;
    left: 0;
    width: 22px;
    height: 8px;
    background: #60A5FA;
    border-radius: 3px 3px 0 0;
  }

  .icon-link .icon-art,
  .icon-mail .icon-art {
    border-radius: 12px;
  }

  .icon-link .icon-art {
    background: linear-gradient(160deg, #38BDF8, #0A66C2);
  }

  .icon-link .icon-art::after {
    content: 'in';
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: #FFFFFF;
    font-weight: 800;
    font-size: 22px;
  }

  .icon-mail .icon-art {
    background: linear-gradient(160deg, #93C5FD, #2563EB);
  }

  .icon-mail .icon-art::after {
    content: '';
    position: absolute;
    inset: 15px 10px;
    border: 2px solid #FFFFFF;
    border-radius: 3px;
    background:
      linear-gradient(to bottom right, transparent 48%, #FFFFFF 49%, #FFFFFF 51%, transparent 52%) left / 50% 100% no-repeat,
      linear-gradient(to bottom left, transparent 48%, #FFFFFF 49%, #FFFFFF 51%, transparent 52%) right / 50% 100% no-repeat;
  }

  .icon-label {
    padding: 1px 6px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 600;
    text-shadow: 0 1px 2px rgba(255, 255, 255, 0.6);
  }

  /* Phones and tablets: icons sit in a row at the end of the home screen. */
  @media (max-width: 1099px) {
    .icons {
      position: static;
      order: 10;
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      gap: 4px;
      width: 100%;
      max-width: 640px;
      margin: 0 auto;
    }
  }
</style>
