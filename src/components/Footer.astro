---
import { SOCIAL_LINKS } from '../consts';

/**
 * The dock. App launchers open (or bring forward) their window; a dot marks
 * apps with a window open, and minimized windows collect at the end, like
 * macOS. The window manager keeps the dots and the minimized section current.
 */
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const currentYear = new Date().getFullYear();

const apps = [
  { href: '/', label: 'Desktop', color: 'linear-gradient(160deg, #C4B5FD, #7C3AED)', glyph: 'M4 11l8-7 8 7M6 9.5V20h12V9.5M10 20v-5h4v5' },
  { href: '/projects', label: 'Projects', color: 'linear-gradient(160deg, #7DD3FC, #2563EB)', glyph: 'M4 6h6l2 2h8v10H4z' },
  { href: '/about', label: 'About', color: 'linear-gradient(160deg, #F0ABFC, #A21CAF)', glyph: 'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-7 8a7 7 0 0 1 14 0' },
  { href: '/blog', label: 'Blog', color: 'linear-gradient(160deg, #FDE68A, #F59E0B)', glyph: 'M7 4h10v16H7zM9.5 8h5M9.5 12h5M9.5 16h3' },
  { href: '/resume', label: 'Resume', color: 'linear-gradient(160deg, #FDA4AF, #E11D48)', glyph: 'M7 3h7l5 5v13H7zM14 3v5h5M10 13h6M10 17h6' },
];

const externals = [
  { href: 'https://calendar.app.google/yYSHV4KQ4zJsxkdt5', label: 'Schedule a chat', color: 'linear-gradient(160deg, #FFFFFF, #E5E7EB)', glyph: 'M5 6h14v13H5zM5 10h14M9 4v4M15 4v4', dark: true },
  { href: SOCIAL_LINKS.github, label: 'GitHub', color: 'linear-gradient(160deg, #4B5563, #111827)', glyph: 'M9 19c-4 1-4-2-6-2m12 4v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1-.3-3.4 1.3a11.6 11.6 0 0 0-6 0C6.8 2.8 5.8 3.1 5.8 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4.4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21' },
  { href: SOCIAL_LINKS.linkedin, label: 'LinkedIn', color: 'linear-gradient(160deg, #38BDF8, #0A66C2)', glyph: 'M7 10v8M7 6.5v.01M11 18v-4.5a2.5 2.5 0 0 1 5 0V18M11 10v8' },
  { href: SOCIAL_LINKS.email, label: 'Email', color: 'linear-gradient(160deg, #93C5FD, #2563EB)', glyph: 'M4 6h16v12H4zM4 7l8 6 8-6' },
];

const isRunning = (href: string) => (href === '/' ? currentPath === '/' : currentPath.startsWith(href));
---

<footer class="dock-area">
  <nav class="dock" aria-label="Dock">
    {apps.map((app) => (
      <a
        class:list={['dock-item', { running: isRunning(app.href) }]}
        href={app.href}
        data-dock-route={app.href}
        aria-label={app.label}
      >
        <span class="dock-icon" style={`background: ${app.color}`}>
          <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={app.glyph} /></svg>
        </span>
        <span class="dock-tip">{app.label}</span>
      </a>
    ))}
    <span class="dock-sep" aria-hidden="true"></span>
    {externals.map((link) => (
      <a
        class="dock-item"
        href={link.href}
        aria-label={link.label}
        target={link.href.startsWith('http') ? '_blank' : undefined}
        rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
      >
        <span class="dock-icon" style={`background: ${link.color}`}>
          <svg viewBox="0 0 24 24" fill="none" stroke={link.dark ? '#111827' : '#fff'} stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={link.glyph} /></svg>
        </span>
        <span class="dock-tip">{link.label}</span>
      </a>
    ))}
    <span class="dock-minimized" data-dock-minimized hidden>
      <span class="dock-sep" aria-hidden="true"></span>
    </span>
  </nav>
  <p class="dock-note">&copy; {currentYear} Michelle Mayes · Made in Austin with Astro, coffee, and too many side projects.</p>
</footer>

<style>
  .dock-area {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding: 32px 16px 24px;
  }

  .dock {
    view-transition-name: dock;
    display: flex;
    align-items: flex-end;
    gap: 8px;
    max-width: 100%;
    padding: 8px 10px;
    background: rgba(255, 255, 255, 0.35);
    -webkit-backdrop-filter: blur(24px) saturate(1.6);
    backdrop-filter: blur(24px) saturate(1.6);
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 22px;
    box-shadow: 0 10px 30px rgba(31, 29, 43, 0.18);
  }

  .dock-minimized {
    display: flex;
    align-items: flex-end;
    gap: 8px;
  }

  .dock-minimized[hidden] {
    display: none;
  }

  .dock :global(.dock-item) {
    position: relative;
    display: block;
    min-width: 0;
    min-height: 0;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    font: inherit;
  }

  .dock :global(.dock-item:active) {
    transform: none;
  }

  .dock :global(.dock-item:focus-visible) {
    outline: 2px solid var(--os-blue);
    outline-offset: 3px;
    border-radius: 14px;
  }

  .dock :global(.dock-icon) {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 13px;
    box-shadow: inset 0 0 0 0.5px rgba(0, 0, 0, 0.12), 0 2px 6px rgba(31, 29, 43, 0.2);
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
    transform-origin: bottom center;
  }

  .dock :global(.dock-icon svg) {
    width: 26px;
    height: 26px;
  }

  .dock :global(.dock-item:hover .dock-icon),
  .dock :global(.dock-item:focus-visible .dock-icon) {
    transform: scale(1.3) translateY(-6px);
  }

  /* A minimized window: a small framed tile, like the right side of the macOS dock. */
  .dock :global(.dock-min .dock-icon) {
    border: 2px solid rgba(255, 255, 255, 0.9);
  }

  /* Running-app dot */
  .dock :global(.running::after) {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -6px;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    border-radius: 50%;
    background: #1F1D2B;
  }

  .dock :global(.dock-tip) {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 20px);
    transform: translateX(-50%);
    padding: 4px 10px;
    border-radius: 6px;
    background: rgba(31, 29, 43, 0.85);
    color: #FFFFFF;
    font-family: var(--font-sans);
    font-size: 12px;
    line-height: 1.2;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease;
  }

  .dock :global(.dock-item:hover .dock-tip),
  .dock :global(.dock-item:focus-visible .dock-tip) {
    opacity: 1;
  }

  .dock-sep {
    align-self: stretch;
    width: 1px;
    margin: 4px 2px;
    background: rgba(31, 29, 43, 0.18);
  }

  .dock-note {
    font-size: 12px;
    color: rgba(31, 29, 43, 0.6);
    text-align: center;
  }

  /* Wide screens: the dock floats over the desktop. */
  @media (min-width: 1100px) {
    .dock-area {
      position: fixed;
      left: 50%;
      bottom: 12px;
      transform: translateX(-50%);
      z-index: 900;
      padding: 0;
    }

    .dock-note {
      display: none;
    }
  }

  @media (max-width: 1099px) {
    .dock {
      overflow-x: auto;
      gap: 6px;
    }

    .dock :global(.dock-icon) {
      width: 44px;
      height: 44px;
    }

    .dock :global(.dock-tip) {
      display: none;
    }

    .dock :global(.dock-item:hover .dock-icon) {
      transform: none;
    }
  }

  @media (max-width: 560px) {
    .dock {
      flex-wrap: wrap;
      justify-content: center;
      overflow: visible;
    }

    .dock-sep {
      display: none;
    }

    .dock :global(.dock-icon) {
      width: 40px;
      height: 40px;
      border-radius: 11px;
    }

    .dock :global(.dock-icon svg) {
      width: 20px;
      height: 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dock :global(.dock-icon) {
      transition: none;
    }

    .dock :global(.dock-item:hover .dock-icon),
    .dock :global(.dock-item:focus-visible .dock-icon) {
      transform: none;
    }
  }
</style>
