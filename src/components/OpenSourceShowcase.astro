---
import type { ShowcaseProject } from '../data/showcase';

interface Props {
  projects: ShowcaseProject[];
  headingLevel?: 'h1' | 'h2';
}

const { projects, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
const [spotlight, ...rest] = projects;
const totalStars = projects.reduce((sum, project) => sum + project.stars, 0);

function prettyHost(url: string): string {
  try {
    return new URL(url).host.replace(/^www\./, '');
  } catch {
    return 'Live site';
  }
}
---

{spotlight && (
  <section class="greenhouse" aria-labelledby="greenhouse-title">
    <div class="greenhouse-heading">
      <span class="eyebrow">
        <span aria-hidden="true">✿</span> The Open Source Greenhouse
      </span>
      <Heading id="greenhouse-title">Things I've grown in the open</Heading>
      <p>
        Free, forkable, and actually used. These are the projects people star, install, and
        ask me about.
      </p>
      {totalStars > 0 && (
        <p class="star-tally">
          <span class="star-tally-icon" aria-hidden="true">★</span>
          <strong>{totalStars}</strong> stars and counting across the greenhouse
        </p>
      )}
    </div>

    <article class={`project spotlight hue-${spotlight.hue}`}>
      <div class="spotlight-art" aria-hidden="true">
        <span class="sticker sticker-lg">{spotlight.glyph}</span>
        <span class="sparkle s1">✦</span>
        <span class="sparkle s2">✧</span>
        <span class="sparkle s3">✦</span>
      </div>
      <div class="spotlight-body">
        <span class="ribbon">Most starred</span>
        <h3 class="project-name">
          <a href={spotlight.url} target="_blank" rel="noopener noreferrer">{spotlight.name}</a>
        </h3>
        <p class="project-tagline">{spotlight.tagline}</p>
        <p class="project-pitch">{spotlight.pitch}</p>
        <ul class="stack" aria-label="Built with">
          {spotlight.stack.map((tech) => <li>{tech}</li>)}
        </ul>
        <div class="project-footer">
          <div class="counts">
            <span class="count" title={`${spotlight.stars} GitHub stars`}>
              <span aria-hidden="true">★</span> {spotlight.stars}<span class="sr-only"> stars</span>
            </span>
            {spotlight.forks > 0 && (
              <span class="count" title={`${spotlight.forks} forks`}>
                <span aria-hidden="true">⑂</span> {spotlight.forks}<span class="sr-only"> forks</span>
              </span>
            )}
          </div>
          <div class="links">
            {spotlight.homepage && (
              <a class="btn btn-solid" href={spotlight.homepage} target="_blank" rel="noopener noreferrer">
                {prettyHost(spotlight.homepage)} <span aria-hidden="true">↗</span>
              </a>
            )}
            <a class="btn btn-ghost" href={spotlight.url} target="_blank" rel="noopener noreferrer">
              Source <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </div>
    </article>

    {rest.length > 0 && (
      <div class="project-grid">
        {rest.map((project, index) => (
          <article class={`project card hue-${project.hue}`} style={`--tilt: ${index % 2 === 0 ? -4 : 4}deg`}>
            <div class="card-top">
              <span class="sticker" aria-hidden="true">{project.glyph}</span>
              {project.stars > 0 ? (
                <span class="count" title={`${project.stars} GitHub stars`}>
                  <span aria-hidden="true">★</span> {project.stars}<span class="sr-only"> stars</span>
                </span>
              ) : (
                <span class="fresh">Freshly planted</span>
              )}
            </div>
            <h3 class="project-name">
              <a href={project.url} target="_blank" rel="noopener noreferrer">{project.name}</a>
            </h3>
            <p class="project-tagline">{project.tagline}</p>
            <p class="project-pitch">{project.pitch}</p>
            <ul class="stack" aria-label="Built with">
              {project.stack.map((tech) => <li>{tech}</li>)}
            </ul>
            <div class="links">
              {project.homepage && (
                <a class="btn btn-solid" href={project.homepage} target="_blank" rel="noopener noreferrer">
                  Try it <span aria-hidden="true">↗</span>
                </a>
              )}
              <a class="btn btn-ghost" href={project.url} target="_blank" rel="noopener noreferrer">
                Source <span aria-hidden="true">↗</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    )}
  </section>
)}

<style>
  .greenhouse {
    margin-top: var(--space-2xl);
  }

  .greenhouse-heading {
    text-align: center;
    max-width: 620px;
    margin: 0 auto var(--space-2xl);
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--leaf-dark);
    background: var(--leaf-50);
    border: 1px dashed var(--leaf);
    padding: 4px 12px;
    border-radius: var(--radius-full);
    margin-bottom: var(--space-md);
  }

  .greenhouse-heading h1,
  .greenhouse-heading h2 {
    font-size: var(--text-fluid-3xl);
    margin-bottom: var(--space-sm);
  }

  .greenhouse-heading p {
    color: var(--text-muted);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
  }

  .star-tally {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: var(--space-md);
    font-size: var(--text-sm) !important;
  }

  .star-tally strong {
    color: var(--text);
    font-family: var(--font-mono);
  }

  .star-tally-icon {
    color: var(--warm-light);
    display: inline-block;
    animation: twinkle 3s ease-in-out infinite;
  }

  /* Colour families */
  .hue-violet { --tint: var(--accent-50); --tint-strong: var(--accent-100); --ink: var(--accent-dark); }
  .hue-leaf   { --tint: var(--leaf-50);   --tint-strong: var(--leaf-100);   --ink: var(--leaf-dark); }
  .hue-amber  { --tint: var(--warm-50);   --tint-strong: var(--warm-100);   --ink: var(--warm-dark); }
  .hue-rose   { --tint: #FFF1F3;          --tint-strong: #FFE0E6;           --ink: #BE185D; }
  .hue-sky    { --tint: #EFF8FF;          --tint-strong: #DBEEFE;           --ink: #0369A1; }

  .project {
    position: relative;
    background: var(--bg-card);
    border: 1px solid var(--tint-strong);
    border-radius: 20px;
    box-shadow: var(--shadow-md);
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.3s ease;
  }

  .project:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 34px rgba(26, 26, 46, 0.1);
  }

  .project-name {
    font-size: var(--text-xl);
    margin: 0 0 4px;
  }

  .project-name a {
    color: var(--text);
    text-decoration: none;
  }

  .project-name a:hover {
    color: var(--ink);
  }

  .project-tagline {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--ink);
    font-size: var(--text-base);
    margin-bottom: var(--space-sm);
    line-height: var(--leading-normal);
  }

  .project-pitch {
    color: var(--text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-md);
  }

  .stack {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: var(--space-md);
  }

  .stack li {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--ink);
    background: var(--tint);
    padding: 3px 10px;
    border-radius: var(--radius-full);
  }

  .count {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text);
    background: var(--warm-50);
    border: 1px solid var(--warm-100);
    padding: 2px 10px;
    border-radius: var(--radius-full);
  }

  .count span[aria-hidden] {
    color: var(--warm-light);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 0 var(--space-md);
    border-radius: 12px;
    font-size: var(--text-sm);
    font-weight: 700;
    text-decoration: none;
    border: 1px solid var(--ink);
    transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }

  .btn-solid {
    background: var(--ink);
    color: white;
  }

  .btn-solid:hover {
    color: white;
    transform: translateY(-1px);
    filter: brightness(1.1);
  }

  .btn-ghost {
    background: transparent;
    color: var(--ink);
  }

  .btn-ghost:hover {
    background: var(--tint);
    color: var(--ink);
  }

  /* Sticker glyphs */
  .sticker {
    display: inline-grid;
    place-items: center;
    width: 56px;
    height: 56px;
    font-size: 1.75rem;
    background: var(--tint);
    border: 3px solid white;
    border-radius: 16px;
    box-shadow: 0 3px 0 var(--tint-strong), var(--shadow-sm);
    transform: rotate(var(--tilt, -4deg));
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .project:hover .sticker {
    transform: rotate(calc(var(--tilt, -4deg) * -2)) scale(1.08);
  }

  /* Spotlight */
  .spotlight {
    display: grid;
    grid-template-columns: minmax(200px, 0.8fr) 1.2fr;
    overflow: hidden;
    margin-bottom: var(--space-lg);
  }

  .spotlight-art {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 260px;
    background:
      radial-gradient(circle at 30% 25%, rgba(255, 255, 255, 0.9) 0 12%, transparent 13%),
      radial-gradient(circle at 70% 80%, var(--tint-strong) 0 30%, transparent 31%),
      linear-gradient(160deg, var(--tint), var(--tint-strong));
  }

  .sticker-lg {
    width: 128px;
    height: 128px;
    font-size: 4rem;
    border-radius: 32px;
    border-width: 5px;
    --tilt: -6deg;
    animation: bob 5s ease-in-out infinite;
  }

  .sparkle {
    position: absolute;
    color: var(--ink);
    opacity: 0.55;
    animation: twinkle 3.2s ease-in-out infinite;
  }

  .s1 { top: 18%; right: 20%; font-size: 1.25rem; }
  .s2 { bottom: 20%; left: 16%; font-size: 1rem; animation-delay: 1s; }
  .s3 { top: 60%; right: 12%; font-size: 0.8rem; animation-delay: 2s; }

  .spotlight-body {
    padding: var(--space-xl);
  }

  .spotlight .project-name {
    font-size: var(--text-fluid-2xl);
  }

  .spotlight .project-tagline {
    font-size: var(--text-lg);
  }

  .ribbon {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--warm-dark);
    background: var(--warm-100);
    padding: 3px 10px;
    border-radius: 6px;
    transform: rotate(-2deg);
    margin-bottom: var(--space-sm);
  }

  .project-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .counts {
    display: flex;
    gap: var(--space-sm);
  }

  /* Grid cards */
  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
  }

  .fresh {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--leaf-dark);
    background: var(--leaf-50);
    border: 1px dashed var(--leaf);
    padding: 2px 10px;
    border-radius: var(--radius-full);
  }

  .card {
    display: flex;
    flex-direction: column;
    padding: var(--space-lg);
    background: linear-gradient(180deg, var(--bg-card) 60%, var(--tint));
  }

  .card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: var(--space-md);
  }

  .card .project-pitch {
    flex: 1;
  }

  @keyframes bob {
    0%, 100% { translate: 0 0; }
    50% { translate: 0 -8px; }
  }

  @keyframes twinkle {
    0%, 100% { opacity: 0.35; scale: 0.85; }
    50% { opacity: 0.9; scale: 1.1; }
  }

  @media (max-width: 720px) {
    .project-grid {
      grid-template-columns: 1fr;
    }

    .spotlight {
      grid-template-columns: 1fr;
    }

    .spotlight-art {
      min-height: 180px;
    }

    .sticker-lg {
      width: 96px;
      height: 96px;
      font-size: 3rem;
    }

    .spotlight-body {
      padding: var(--space-lg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sticker-lg,
    .sparkle,
    .star-tally-icon {
      animation: none;
    }

    .project,
    .sticker {
      transition: none;
    }

    .project:hover {
      transform: none;
    }

    .sticker,
    .project:hover .sticker {
      transform: rotate(var(--tilt, -4deg));
    }
  }
</style>
