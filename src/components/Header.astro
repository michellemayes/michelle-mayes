---
import { SITE_TITLE } from '../consts';

interface Props {
  /** The project shown in the menu bar's status item. */
  now?: { name: string; url: string } | null;
}

const { now = null } = Astro.props;
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/projects', label: 'Projects' },
  { href: '/about', label: 'About' },
  { href: '/blog', label: 'Blog' },
  { href: '/resume', label: 'Resume' },
];
---

<a href="#main-content" class="skip-link">Skip to content</a>
<header class="menubar">
  <div class="menu-left">
    <a href="/" class="menu-logo" aria-label={`${SITE_TITLE} home`}>✦</a>
    <a href="/" class="menu-brand">Michelle OS</a>
    <nav aria-label="Main navigation">
      {navLinks.map(({ href, label }) => (
        <a
          href={href}
          class:list={{ active: currentPath.startsWith(href) }}
          aria-current={currentPath.startsWith(href) ? 'page' : undefined}
        >
          {label}
        </a>
      ))}
    </nav>
  </div>
  <div class="menu-right">
    {now && (
      <a href={now.url} class="menu-now" target="_blank" rel="noopener noreferrer" title="Currently tinkering on">
        <span class="menu-now-dot" aria-hidden="true"></span>{now.name}
      </a>
    )}
    <time class="menu-clock" data-clock></time>
    <script is:inline>
      // Runs during parsing (not after load) so the clock is already filled
      // in on the page's first paint instead of popping in afterwards.
      (function () {
        var clock = document.querySelector('[data-clock]');
        if (!clock) return;
        var render = function () {
          var now = new Date();
          clock.textContent = now.toLocaleString('en-US', { weekday: 'short', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
          clock.dateTime = now.toISOString();
        };
        render();
        setInterval(render, 30000);
      })();
    </script>
  </div>
</header>

<style>
  .menubar {
    view-transition-name: menubar;
    position: sticky;
    top: 0;
    z-index: 1000;
    height: var(--menubar-height);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 0 14px;
    background: rgba(255, 255, 255, 0.55);
    -webkit-backdrop-filter: blur(20px) saturate(1.6);
    backdrop-filter: blur(20px) saturate(1.6);
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 1;
    color: #1F1D2B;
  }

  .menu-left,
  .menu-right,
  nav {
    display: flex;
    align-items: center;
    gap: 4px;
    min-width: 0;
  }

  .menubar a {
    display: inline-flex;
    align-items: center;
    height: 22px;
    padding: 0 8px;
    border-radius: 5px;
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
  }

  .menubar a:hover,
  .menubar a.active {
    background: rgba(0, 0, 0, 0.08);
    color: inherit;
  }

  .menubar a:active {
    transform: none;
  }

  .menu-logo {
    font-size: 15px;
  }

  .menu-brand {
    font-weight: 700;
  }

  .menubar .menu-now {
    gap: 6px;
    color: #15803D;
    font-weight: 500;
  }

  .menu-now-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #22C55E;
  }

  .menu-clock {
    padding: 0 4px;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  @media (max-width: 720px) {
    .menu-now {
      display: none !important;
    }
  }

  @media (max-width: 560px) {
    .menubar {
      padding: 0 6px;
    }

    .menu-brand,
    .menu-clock {
      display: none;
    }

    .menubar a {
      padding: 0 7px;
    }
  }
</style>
