---
import Desktop from '../layouts/Desktop.astro';
import Window from '../components/Window.astro';
import { SITE_TITLE, GITHUB_USERNAME, SOCIAL_LINKS } from '../consts';
import { SHOWCASE_ICONS, buildShowcase } from '../data/showcase';
import { bucketProjects, getProjectDescription, loadRepositories } from '../lib/projects';

// Render on request so new repos and star counts show up without a redeploy.
// The CDN serves a cached copy for 5 minutes, then refreshes in the background.
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=300, stale-while-revalidate=86400');

const repositories = await loadRepositories(GITHUB_USERNAME);
const showcase = buildShowcase(repositories);
const showcased = new Set(showcase.map((project) => project.url));
const { catalog: catalogRepositories } = bucketProjects(
  repositories.filter((repo) => !showcased.has(repo.html_url)),
  0
);
const totalStars = showcase.reduce((sum, project) => sum + project.stars, 0);
const itemCount = showcase.length + catalogRepositories.length;

const LANGUAGE_COLORS: Record<string, string> = {
  TypeScript: '#3178C6',
  JavaScript: '#E5C100',
  Python: '#3572A5',
  Rust: '#DEA584',
  Swift: '#F05138',
  Astro: '#FF5D01',
  HTML: '#E34C26',
  R: '#276DC3',
};
const languageColor = (language: string | null) => (language && LANGUAGE_COLORS[language]) || '#94A3B8';

const languageCounts = new Map<string, number>();
for (const language of [...showcase.map((p) => p.language), ...catalogRepositories.map((r) => r.language)]) {
  if (language) languageCounts.set(language, (languageCounts.get(language) ?? 0) + 1);
}
const languages = [...languageCounts.entries()].sort((a, b) => b[1] - a[1]);

const tagsFor = (group: string, language: string | null) => [group, language ? `lang:${language}` : ''].filter(Boolean).join('|');
const formatUpdated = (iso: string) =>
  new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---

<Desktop
  title={`Projects - ${SITE_TITLE}`}
  description="Most-starred open source projects by Michelle Mayes, plus the full GitHub catalog of experiments and prototypes."
  appName="Finder"
>
  <Window
    id="app-projects"
    title="Projects"
    titleAs="p"
    route="/projects"
    appName="Finder"
    docTitle={`Projects - ${SITE_TITLE}`}
    meta={`${itemCount} items · ★ ${totalStars}`}
    width={1180}
    height={820}
    icon={{ color: 'linear-gradient(160deg, #7DD3FC, #2563EB)', glyph: 'M4 6h6l2 2h8v10H4z' }}
    primary
    class="app-projects"
  >
  <div class="os-split browser" data-filter-root>
    <nav class="os-sidebar" aria-label="Filter projects">
      <p class="os-sidebar-label">Favorites</p>
      <button type="button" class="os-sidebar-item" data-filter="" aria-pressed="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z" /></svg>
        All Projects<span class="count">{itemCount}</span>
      </button>
      <button type="button" class="os-sidebar-item" data-filter="showcase" aria-pressed="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z" /></svg>
        Open Source<span class="count">{showcase.length}</span>
      </button>
      <button type="button" class="os-sidebar-item" data-filter="experiment" aria-pressed="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 3h6M10 3v6l-5 9a2 2 0 0 0 1.8 3h10.4a2 2 0 0 0 1.8-3l-5-9V3" /></svg>
        Experiments<span class="count">{catalogRepositories.length}</span>
      </button>

      {languages.length > 0 && <p class="os-sidebar-label">Languages</p>}
      {languages.map(([language, count]) => (
        <button type="button" class="os-sidebar-item" data-filter={`lang:${language}`} aria-pressed="false">
          <i class="os-dot" style={`background: ${languageColor(language)}`}></i>
          {language}<span class="count">{count}</span>
        </button>
      ))}

      <p class="os-sidebar-label">Locations</p>
      <a class="os-sidebar-item" href={SOCIAL_LINKS.github} target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM3.6 9h16.8M3.6 15h16.8M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" /></svg>
        GitHub ↗
      </a>
    </nav>

    <div class="pane">
      <header class="pane-head">
        <h1 class="os-heading">Projects</h1>
        <p class="os-subtitle">The open source projects I'm proudest of, plus everything else on my GitHub.</p>
      </header>

      {showcase.length > 0 && (
        <section class="group" data-filter-section aria-labelledby="oss-title">
          <h2 class="os-section-title" id="oss-title">Open Source <span class="count">★ {totalStars} across {showcase.length}</span></h2>
          <ul class="gallery">
            {showcase.map((project) => (
              <li data-filter-tags={tagsFor('showcase', project.language)}>
                <a class="tile" href={project.url} target="_blank" rel="noopener noreferrer">
                  <span class={`app-icon tile-icon hue-${project.hue}`}>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={SHOWCASE_ICONS[project.icon]} />
                  </span>
                  <span class="tile-name">{project.name}</span>
                  <span class="tile-tagline">{project.tagline}</span>
                  <span class="tile-pitch">{project.pitch}</span>
                  <span class="tile-foot">
                    <span class="tile-stack">{project.stack.map((item) => <span class="os-pill">{item}</span>)}</span>
                    <span class="tile-stats" aria-label={`${project.stars} stars, ${project.forks} forks`}>★ {project.stars}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      {catalogRepositories.length > 0 && (
        <section class="group" data-filter-section aria-labelledby="exp-title">
          <h2 class="os-section-title" id="exp-title">Experiments <span class="count">ranked by traction and recency</span></h2>
          <div class="list">
            <div class="list-head" aria-hidden="true">
              <span>Name</span>
              <span>Language</span>
              <span>★</span>
              <span>Updated</span>
            </div>
            {catalogRepositories.map((repo) => (
              <a class="list-row" href={repo.html_url} target="_blank" rel="noopener noreferrer" data-filter-tags={tagsFor('experiment', repo.language)}>
                <span class="list-name">
                  <span class="app-icon hue-slate" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h6l2 2h8v10H4z" /></svg>
                  </span>
                  <span class="list-text">
                    <strong>{repo.name}</strong>
                    <small>{getProjectDescription(repo.description)}</small>
                  </span>
                </span>
                <span class="list-lang">
                  {repo.language && <><i class="os-dot" style={`background: ${languageColor(repo.language)}`}></i>{repo.language}</>}
                </span>
                <span class="list-stars" aria-label={`${repo.stargazers_count} stars`}>{repo.stargazers_count}</span>
                <span class="list-date">{formatUpdated(repo.updated_at)}</span>
              </a>
            ))}
          </div>
        </section>
      )}

      <p class="empty" data-filter-empty hidden>No projects match that filter.</p>

      {repositories.length === 0 && (
        <div class="empty-state">
          <h2 class="os-section-title">Couldn't load projects</h2>
          <p>GitHub isn't responding right now. Check back shortly or <a href={SOCIAL_LINKS.github} target="_blank" rel="noopener">browse directly on GitHub</a>.</p>
        </div>
      )}
    </div>
  </div>
  </Window>
</Desktop>

