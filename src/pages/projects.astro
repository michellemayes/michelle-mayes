---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import OpenSourceShowcase from '../components/OpenSourceShowcase.astro';
import { SITE_TITLE, GITHUB_USERNAME } from '../consts';
import { buildShowcase } from '../data/showcase';
import { bucketProjects, getProjectDescription, loadRepositories } from '../lib/projects';

export const prerender = true;

const repositories = await loadRepositories(GITHUB_USERNAME);
const showcase = buildShowcase(repositories);
const showcased = new Set(showcase.map((project) => project.url));
const { catalog: catalogRepositories } = bucketProjects(
  repositories.filter((repo) => !showcased.has(repo.html_url)),
  0
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Projects - ${SITE_TITLE}`}
      description="Most-starred open source projects by Michelle Mayes, plus the full GitHub catalog of experiments and prototypes."
    />
  </head>
  <body>
    <Header />
    <main id="main-content">
      <div class="section-header">
        <h1>Selected Work</h1>
        <p>
          The open source projects I'm proudest of, plus everything else sprouting on my GitHub.
        </p>
      </div>

      <OpenSourceShowcase projects={showcase} />

      {catalogRepositories.length > 0 && (
        <section class="catalog-section">
          <div class="section-heading">
            <h2>The Seed Tray</h2>
            <p>Experiments, prototypes, and side quests, ranked by traction and recency.</p>
          </div>

          <div class="projects-grid">
            {catalogRepositories.map((repo) => (
              <article class="project-card-small">
                <div class="project-card-header">
                  <h3>
                    <a href={repo.html_url} target="_blank" rel="noopener noreferrer">{repo.name}</a>
                  </h3>
                  <div class="project-stats">
                    <span>⭐ {repo.stargazers_count}</span>
                    <span>🍴 {repo.forks_count}</span>
                  </div>
                </div>

                <div class="project-card-content">
                  <p class="project-description">
                    {getProjectDescription(repo.description)}
                  </p>

                  <div class="project-meta">
                    {repo.language && <span class="language-badge">{repo.language}</span>}
                    <span class="update-date">Updated {new Date(repo.updated_at).toLocaleDateString()}</span>
                  </div>
                </div>

                <div class="project-card-footer">
                  <a href={repo.html_url} class="project-link" target="_blank" rel="noopener noreferrer">
                    View on GitHub
                  </a>
                </div>
              </article>
            ))}
          </div>
        </section>
      )}

      {repositories.length === 0 && (
        <div class="empty-state">
          <h3>Couldn't load projects</h3>
          <p>GitHub isn't responding right now. Check back shortly or <a href="https://github.com/michellemayes" target="_blank" rel="noopener">browse directly on GitHub</a>.</p>
        </div>
      )}
    </main>
    <Footer />
  </body>
</html>

<style>
  main {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-xl);
  }

  .section-header {
    text-align: center;
    margin-bottom: var(--space-2xl);
  }

  .section-header h1 {
    font-size: var(--text-fluid-4xl);
    margin-bottom: var(--space-sm);
    color: var(--accent);
  }

  .section-header p {
    font-size: var(--text-lg);
    color: var(--text-muted);
    max-width: 680px;
    margin: 0 auto;
    line-height: var(--leading-normal);
  }

  .catalog-section {
    margin-top: var(--space-3xl);
    margin-bottom: var(--space-2xl);
  }

  .section-heading {
    margin-bottom: var(--space-md);
  }

  .section-heading h2 {
    font-size: var(--text-fluid-2xl);
    margin-bottom: var(--space-xs);
  }

  .section-heading p {
    color: var(--text-muted);
    margin: 0;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-md);
  }

  .project-card-small {
    background: var(--bg-card);
    border: 1px solid var(--accent-100);
    border-radius: var(--radius-lg);
    padding: var(--space-md);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  .project-card-small:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .project-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: var(--space-sm);
    gap: var(--space-sm);
  }

  .project-card-small h3 {
    margin: 0;
    font-size: var(--text-base);
    flex: 1;
  }

  .project-card-small h3 a {
    color: var(--accent);
    text-decoration: none;
  }

  .project-card-small h3 a:hover {
    text-decoration: underline;
  }

  .project-stats {
    display: flex;
    gap: var(--space-sm);
    font-size: var(--text-xs);
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .project-card-content {
    flex: 1;
    margin-bottom: var(--space-md);
  }

  .project-description {
    margin: 0 0 var(--space-sm) 0;
    color: var(--text-muted);
    line-height: var(--leading-normal);
    font-size: var(--text-sm);
  }

  .project-meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: var(--text-xs);
  }

  .language-badge {
    background: var(--accent-100);
    color: var(--accent-dark);
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .update-date {
    color: var(--text-muted);
  }

  .project-card-footer {
    margin-top: auto;
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: max-content;
    min-height: 44px;
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: 700;
    background: var(--accent-50);
    color: var(--accent-dark);
    border: 1px solid var(--accent-200);
    text-decoration: none;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .project-link:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: white;
  }

  .empty-state {
    text-align: center;
    padding: var(--space-2xl);
    background: var(--bg-card);
    border: 1px solid var(--accent-100);
    border-radius: var(--radius-lg);
  }

  .empty-state p {
    color: var(--text-muted);
    margin-bottom: 0;
  }

  @media (max-width: 768px) {
    main {
      padding: var(--space-md);
    }

    .section-header p {
      font-size: var(--text-base);
    }

    .project-link {
      width: 100%;
    }
  }

  @media (max-width: 480px) {
    main {
      padding: var(--space-sm);
    }

    .section-heading p {
      font-size: var(--text-sm);
    }

    .project-card-small {
      padding: var(--space-md);
    }

    .empty-state {
      padding: var(--space-lg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card-small {
      transition: none;
    }

    .project-card-small:hover {
      transform: none;
    }
  }
</style>
