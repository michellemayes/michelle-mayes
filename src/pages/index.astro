---
import Window from '../components/Window.astro';
import Desktop from '../layouts/Desktop.astro';
import { GITHUB_USERNAME, SITE_DESCRIPTION, SITE_TITLE_FULL, SOCIAL_LINKS } from '../consts';
import { SHOWCASE_ICONS, buildShowcase } from '../data/showcase';
import { getHomeData } from '../lib/home-data';
import { loadRepositories } from '../lib/projects';

// Render on request so new repos and star counts show up without a redeploy.
// The CDN serves a cached copy for 5 minutes, then refreshes in the background.
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=300, stale-while-revalidate=86400');

const [{ stats, timelineItems }, repositories] = await Promise.all([
	getHomeData(),
	loadRepositories(GITHUB_USERNAME, 100),
]);
const showcase = buildShowcase(repositories);
const totalStars = showcase.reduce((sum, project) => sum + project.stars, 0);
const timeline = timelineItems.filter((item) => !item.isPrivate);
const [latest, previous] = timeline;
const currentlyBuilding = latest ? { name: latest.title, url: latest.repoUrl } : null;

const CALENDAR_URL = 'https://calendar.app.google/yYSHV4KQ4zJsxkdt5';

const formatDate = (iso: string) =>
	new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

const personSchema = {
	"@context": "https://schema.org",
	"@type": "Person",
	"name": "Michelle Mayes",
	"url": "https://michellemayes.me",
	"jobTitle": "Full-Stack Builder & AI Product Engineer",
	"description": SITE_DESCRIPTION,
	"image": "https://michellemayes.me/avatar.jpg",
	"sameAs": [
		SOCIAL_LINKS.github,
		SOCIAL_LINKS.linkedin,
		SOCIAL_LINKS.twitter,
	],
};

const windowDefaults = { route: '/', docTitle: SITE_TITLE_FULL, kind: 'home' as const };
---

<Desktop
	title={SITE_TITLE_FULL}
	description={SITE_DESCRIPTION}
	jsonLd={personSchema}
	appName="Michelle OS"
	now={currentlyBuilding}
>
	<Window
		{...windowDefaults}
		id="home-welcome"
		title="Welcome"
		titleId="welcome-title"
		appName="Michelle OS"
		primary
		icon={{ color: 'linear-gradient(160deg, #F0ABFC, #A21CAF)', glyph: 'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-7 8a7 7 0 0 1 14 0' }}
		class="home-welcome"
	>
		<div class="welcome">
			<img src="/avatar.jpg" alt="Michelle Mayes" width="112" height="112" loading="eager" decoding="async" fetchpriority="high" />
			<h1>Michelle Mayes</h1>
			<p class="welcome-role">Full-Stack Builder &amp; AI Product Engineer</p>
			<p class="welcome-tagline">I ship fast. AI keeps up.</p>
			<p class="welcome-sub">
				Product-minded full-stack builder making practical AI tools, cozy Mac apps, and the occasional grocery
				robot. Always with measurable outcomes.
			</p>
			<div class="welcome-actions">
				<a class="mac-btn primary" href={CALENDAR_URL} target="_blank" rel="noopener noreferrer">Schedule a chat</a>
				<a class="mac-btn" href="/about">About me</a>
			</div>
		</div>
	</Window>

	<Window
		{...windowDefaults}
		id="home-finder"
		title="Open Source"
		titleId="finder-title"
		appName="Finder"
		meta={`${showcase.length} items · ★ ${totalStars}`}
		icon={{ color: 'linear-gradient(160deg, #7DD3FC, #2563EB)', glyph: 'M4 6h6l2 2h8v10H4z' }}
		class="home-finder"
	>
		<div class="finder">
			<nav class="os-sidebar finder-side" aria-label="Places">
				<p class="os-sidebar-label">Favorites</p>
				<span class="os-sidebar-item is-active">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z" /></svg>
					Open Source
				</span>
				<a class="os-sidebar-item" href="/projects">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z" /></svg>
					All Projects
				</a>
				<a class="os-sidebar-item" href="/blog">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 19l3-1 10-10-2-2L6 16zM14 6l2 2" /></svg>
					Blog
				</a>
				<a class="os-sidebar-item" href="/resume">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 3h7l5 5v13H7zM14 3v5h5M10 13h6M10 17h6" /></svg>
					Resume
				</a>
			</nav>
			<div class="finder-main">
				<div class="finder-head" aria-hidden="true"><span>Name</span><span>Kind</span><span>★</span></div>
				<ul class="finder-list">
					{showcase.map((project) => (
						<li>
							<a href={project.url} target="_blank" rel="noopener noreferrer" title={project.pitch}>
								<span class="f-name">
									<span class={`app-icon hue-${project.hue}`} aria-hidden="true">
										<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={SHOWCASE_ICONS[project.icon]} />
									</span>
									<span>
										<strong>{project.name}</strong>
										<small>{project.tagline}</small>
									</span>
								</span>
								<span class="f-kind">{project.stack[0]}</span>
								<span class="f-stars">{project.stars}</span>
							</a>
						</li>
					))}
				</ul>
			</div>
		</div>
	</Window>

	<Window
		{...windowDefaults}
		id="home-log"
		title="shipping-log.txt"
		titleId="log-title"
		appName="TextEdit"
		meta="Edited"
		icon={{ color: 'linear-gradient(160deg, #FDBA74, #EA580C)', glyph: 'M7 4h10v16H7zM9.5 8h5M9.5 12h5M9.5 16h3' }}
		class="home-log"
	>
		<ol class="log">
			{timeline.map((item) => (
				<li>
					<span class="log-date">{formatDate(item.date)}</span>
					<a href={item.repoUrl} target="_blank" rel="noopener noreferrer">{item.title}</a>
					<p>{item.description}</p>
				</li>
			))}
		</ol>
	</Window>

	<aside class="widget" id="desktop-github" data-desktop-item aria-label="GitHub stats">
		<p class="widget-label">GitHub</p>
		<div class="widget-grid">
			<div><b>{stats.totalRepos}</b><span>repos</span></div>
			<div><b>{stats.recentActivity}</b><span>active this month</span></div>
			<div><b>{totalStars}</b><span>stars</span></div>
			<div><b>{stats.primaryLanguagePercent}%</b><span>{stats.primaryLanguage}</span></div>
		</div>
	</aside>

	<aside class="sticky" id="desktop-sticky" data-desktop-item aria-label="To-do note">
		<p>To do:</p>
		<ul>
			{previous && <li class="done">ship {previous.title.toLowerCase()}</li>}
			{latest && <li>finish {latest.title.toLowerCase()}</li>}
			<li><a href={CALENDAR_URL} target="_blank" rel="noopener noreferrer">grab coffee w/ you?</a></li>
		</ul>
	</aside>
</Desktop>

<script>
	// Console easter egg for developer visitors
	console.log('%c👋 Hey there, curious dev!', 'font-size: 16px; font-weight: bold; color: #7C3AED;');
	console.log(
		'%cThis desktop is built with Astro and pulls live data from GitHub. Drag the windows, minimize them to the dock, or open a few apps at once.\nLike what you see? Let\'s chat → https://calendar.app.google/yYSHV4KQ4zJsxkdt5',
		'font-size: 12px; color: #6B6876;'
	);
</script>
