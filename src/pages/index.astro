---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { GITHUB_USERNAME, SITE_DESCRIPTION, SITE_TITLE_FULL, SOCIAL_LINKS } from '../consts';
import { buildShowcase } from '../data/showcase';
import { getHomeData } from '../lib/home-data';
import { loadRepositories } from '../lib/projects';

// Render on request so new repos and star counts show up without a redeploy.
// The CDN serves a cached copy for 5 minutes, then refreshes in the background.
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=300, stale-while-revalidate=86400');

const [{ stats, timelineItems }, repositories] = await Promise.all([
	getHomeData(),
	loadRepositories(GITHUB_USERNAME, 100),
]);
const showcase = buildShowcase(repositories);
const totalStars = showcase.reduce((sum, project) => sum + project.stars, 0);
const timeline = timelineItems.filter((item) => !item.isPrivate);
const [latest, previous] = timeline;
const currentlyBuilding = latest ? { name: latest.title, url: latest.repoUrl } : null;

const CALENDAR_URL = 'https://calendar.app.google/yYSHV4KQ4zJsxkdt5';

const formatDate = (iso: string) =>
	new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

const desktopIcons = [
	{ href: '/resume.pdf', label: 'Resume.pdf', kind: 'file' },
	{ href: '/blog', label: 'Blog', kind: 'folder' },
	{ href: '/about', label: 'About', kind: 'folder' },
	{ href: SOCIAL_LINKS.linkedin, label: 'LinkedIn', kind: 'link' },
	{ href: SOCIAL_LINKS.email, label: 'Say hi', kind: 'mail' },
];

const dockApps = [
	{ window: 'about', label: 'About Me', color: 'linear-gradient(160deg, #F0ABFC, #A21CAF)', glyph: 'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-7 8a7 7 0 0 1 14 0' },
	{ window: 'finder', label: 'Open Source', color: 'linear-gradient(160deg, #7DD3FC, #2563EB)', glyph: 'M4 6h6l2 2h8v10H4z' },
	{ window: 'log', label: 'Shipping Log', color: 'linear-gradient(160deg, #FDBA74, #EA580C)', glyph: 'M7 4h10v16H7zM9.5 8h5M9.5 12h5M9.5 16h3' },
];

const personSchema = {
	"@context": "https://schema.org",
	"@type": "Person",
	"name": "Michelle Mayes",
	"url": "https://michellemayes.me",
	"jobTitle": "Full-Stack Builder & AI Product Engineer",
	"description": SITE_DESCRIPTION,
	"image": "https://michellemayes.me/avatar.jpg",
	"sameAs": [
		SOCIAL_LINKS.github,
		SOCIAL_LINKS.linkedin,
		SOCIAL_LINKS.twitter,
	],
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE_FULL} description={SITE_DESCRIPTION} jsonLd={personSchema} />
	</head>
	<body>
		<Header now={currentlyBuilding} />

		<main id="main-content" class="desktop">
			<ul class="icons" aria-label="Desktop shortcuts">
				{desktopIcons.map((icon) => (
					<li>
						<a href={icon.href} class={`icon icon-${icon.kind}`}>
							<span class="icon-art" aria-hidden="true"></span>
							<span class="icon-label">{icon.label}</span>
						</a>
					</li>
				))}
			</ul>

			<section class="window win-about" data-window="about" aria-labelledby="about-title">
				<div class="titlebar" data-drag>
					<span class="lights"><button type="button" class="light close" data-close aria-label="Close About Me"></button><i></i><i></i></span>
					<h2 class="win-title" id="about-title">About Me</h2>
				</div>
				<div class="win-body about-body">
					<img src="/avatar.jpg" alt="Michelle Mayes" width="112" height="112" loading="eager" decoding="async" fetchpriority="high" />
					<h1>Michelle Mayes</h1>
					<p class="about-role">Full-Stack Builder &amp; AI Product Engineer</p>
					<p class="about-tagline">I ship fast. AI keeps up.</p>
					<p class="about-sub">
						Product-minded full-stack builder making practical AI tools, cozy Mac apps, and the occasional grocery
						robot. Always with measurable outcomes.
					</p>
					<div class="about-actions">
						<a class="mac-btn primary" href={CALENDAR_URL} target="_blank" rel="noopener noreferrer">Schedule a chat</a>
						<a class="mac-btn" href="/resume">Resume</a>
					</div>
				</div>
			</section>

			<section class="window win-finder" data-window="finder" aria-labelledby="finder-title">
				<div class="titlebar" data-drag>
					<span class="lights"><button type="button" class="light close" data-close aria-label="Close Open Source"></button><i></i><i></i></span>
					<h2 class="win-title" id="finder-title">Open Source</h2>
					<span class="win-meta">{showcase.length} items · ★ {totalStars}</span>
				</div>
				<div class="finder">
					<aside class="finder-side">
						<p>Favorites</p>
						<a href="#finder-title" class="active">Open Source</a>
						<a href="#log-title">Shipping Log</a>
						<a href="/projects">All Projects</a>
						<p>Tags</p>
						<span><i class="dot violet"></i>AI tools</span>
						<span><i class="dot amber"></i>Mac apps</span>
						<span><i class="dot leaf"></i>Dev tools</span>
					</aside>
					<div class="finder-main">
						<div class="finder-head" aria-hidden="true"><span>Name</span><span>Kind</span><span>★</span></div>
						<ul class="finder-list">
							{showcase.map((project) => (
								<li>
									<a href={project.url} target="_blank" rel="noopener noreferrer" title={project.pitch}>
										<span class="f-name">
											<i class={`f-icon hue-${project.hue}`} aria-hidden="true"></i>
											<span>
												<strong>{project.name}</strong>
												<small>{project.tagline}</small>
											</span>
										</span>
										<span class="f-kind">{project.stack[0]}</span>
										<span class="f-stars">{project.stars}</span>
									</a>
								</li>
							))}
						</ul>
					</div>
				</div>
			</section>

			<section class="window win-log" data-window="log" aria-labelledby="log-title">
				<div class="titlebar" data-drag>
					<span class="lights"><button type="button" class="light close" data-close aria-label="Close Shipping Log"></button><i></i><i></i></span>
					<h2 class="win-title" id="log-title">shipping-log.txt</h2>
					<span class="win-meta">Edited</span>
				</div>
				<ol class="win-body log-body">
					{timeline.map((item) => (
						<li>
							<span class="log-date">{formatDate(item.date)}</span>
							<a href={item.repoUrl} target="_blank" rel="noopener noreferrer">{item.title}</a>
							<p>{item.description}</p>
						</li>
					))}
				</ol>
			</section>

			<aside class="widget" aria-label="GitHub stats">
				<p class="widget-label">GitHub</p>
				<div class="widget-grid">
					<div><b>{stats.totalRepos}</b><span>repos</span></div>
					<div><b>{stats.recentActivity}</b><span>active this month</span></div>
					<div><b>{totalStars}</b><span>stars</span></div>
					<div><b>{stats.primaryLanguagePercent}%</b><span>{stats.primaryLanguage}</span></div>
				</div>
			</aside>

			<aside class="sticky" aria-label="To-do note">
				<p>To do:</p>
				<ul>
					{previous && <li class="done">ship {previous.title.toLowerCase()}</li>}
					{latest && <li>finish {latest.title.toLowerCase()}</li>}
					<li><a href={CALENDAR_URL} target="_blank" rel="noopener noreferrer">grab coffee w/ you?</a></li>
				</ul>
			</aside>
		</main>

		<Footer apps={dockApps} floating />

		<script>
			// Window management: focus, drag (wide screens only), close, and reopen from the dock.
			const wide = window.matchMedia('(min-width: 1100px)');
			const windows = Array.from(document.querySelectorAll<HTMLElement>('[data-window]'));
			let topZ = 10;

			const focusWindow = (win: HTMLElement) => {
				windows.forEach((w) => w.classList.remove('is-focused'));
				win.classList.add('is-focused');
				win.style.zIndex = String(++topZ);
			};

			windows.forEach((win) => {
				win.addEventListener('pointerdown', () => focusWindow(win));

				win.querySelector('[data-close]')?.addEventListener('click', (event) => {
					event.stopPropagation();
					win.classList.add('is-closed');
				});

				const handle = win.querySelector<HTMLElement>('[data-drag]');
				if (!handle) return;

				handle.addEventListener('pointerdown', (event) => {
					if (!wide.matches || (event.target as HTMLElement).closest('button')) return;
					const desktop = win.offsetParent as HTMLElement;
					const startX = event.clientX - win.offsetLeft;
					const startY = event.clientY - win.offsetTop;
					handle.setPointerCapture(event.pointerId);
					win.classList.add('is-dragging');

					const move = (e: PointerEvent) => {
						const maxX = desktop.clientWidth - 80;
						const maxY = desktop.clientHeight - 40;
						win.style.left = `${Math.min(Math.max(e.clientX - startX, -win.offsetWidth + 80), maxX)}px`;
						win.style.top = `${Math.min(Math.max(e.clientY - startY, 0), maxY)}px`;
					};
					const stop = () => {
						win.classList.remove('is-dragging');
						handle.removeEventListener('pointermove', move);
						handle.removeEventListener('pointerup', stop);
						handle.removeEventListener('pointercancel', stop);
					};
					handle.addEventListener('pointermove', move);
					handle.addEventListener('pointerup', stop);
					handle.addEventListener('pointercancel', stop);
				});
			});

			document.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((button) => {
				button.addEventListener('click', () => {
					const win = document.querySelector<HTMLElement>(`[data-window="${button.dataset.open}"]`);
					if (!win) return;
					win.classList.remove('is-closed');
					focusWindow(win);
					if (!wide.matches) win.scrollIntoView({ behavior: 'smooth', block: 'start' });
				});
			});

			// Console easter egg for developer visitors
			console.log('%c👋 Hey there, curious dev!', 'font-size: 16px; font-weight: bold; color: #7C3AED;');
			console.log(
				'%cThis desktop is built with Astro and pulls live data from GitHub. Try dragging the windows around.\nLike what you see? Let\'s chat → https://calendar.app.google/yYSHV4KQ4zJsxkdt5',
				'font-size: 12px; color: #6B6876;'
			);
		</script>
	</body>
</html>

<style>
	.desktop {
		position: relative;
		min-height: max(calc(100vh - var(--menubar-height)), 880px);
		padding-bottom: 120px;
		font-size: 14px;
		line-height: 1.5;
		color: #1F1D2B;
	}

	.desktop a {
		color: inherit;
	}

	.desktop a:active,
	.desktop button:active {
		transform: none;
		opacity: 1;
	}

	.desktop a:focus-visible,
	.desktop button:focus-visible {
		outline: 2px solid var(--os-blue);
		outline-offset: 2px;
		border-radius: 6px;
	}

	/* Desktop icons */
	.icons {
		position: absolute;
		top: 20px;
		right: 20px;
		list-style: none;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 14px;
	}

	.icon {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 4px;
		width: 84px;
		padding: 6px 4px;
		border-radius: 8px;
		text-align: center;
	}

	.icon:hover .icon-label {
		background: var(--os-blue);
		color: #FFFFFF;
	}

	.icon-art {
		position: relative;
		width: 52px;
		height: 52px;
		filter: drop-shadow(0 4px 6px rgba(31, 29, 43, 0.2));
	}

	.icon-file .icon-art {
		width: 42px;
		background: #FFFFFF;
		border-radius: 4px;
		clip-path: polygon(0 0, 70% 0, 100% 22%, 100% 100%, 0 100%);
	}

	.icon-file .icon-art::after {
		content: 'PDF';
		position: absolute;
		left: 4px;
		right: 4px;
		bottom: 8px;
		padding: 1px 0;
		background: #DC2626;
		color: #FFFFFF;
		font-size: 9px;
		font-weight: 800;
		line-height: 1.4;
		border-radius: 2px;
	}

	.icon-folder .icon-art {
		height: 40px;
		margin-top: 8px;
		background: linear-gradient(180deg, #7DD3FC, #3B82F6);
		border-radius: 3px 6px 6px 6px;
	}

	.icon-folder .icon-art::before {
		content: '';
		position: absolute;
		top: -6px;
		left: 0;
		width: 22px;
		height: 8px;
		background: #60A5FA;
		border-radius: 3px 3px 0 0;
	}

	.icon-link .icon-art,
	.icon-mail .icon-art {
		border-radius: 12px;
	}

	.icon-link .icon-art {
		background: linear-gradient(160deg, #38BDF8, #0A66C2);
	}

	.icon-link .icon-art::after {
		content: 'in';
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		color: #FFFFFF;
		font-weight: 800;
		font-size: 22px;
	}

	.icon-mail .icon-art {
		background: linear-gradient(160deg, #93C5FD, #2563EB);
	}

	.icon-mail .icon-art::after {
		content: '';
		position: absolute;
		inset: 15px 10px;
		border: 2px solid #FFFFFF;
		border-radius: 3px;
		background:
			linear-gradient(to bottom right, transparent 48%, #FFFFFF 49%, #FFFFFF 51%, transparent 52%) left / 50% 100% no-repeat,
			linear-gradient(to bottom left, transparent 48%, #FFFFFF 49%, #FFFFFF 51%, transparent 52%) right / 50% 100% no-repeat;
	}

	.icon-label {
		padding: 1px 6px;
		border-radius: 4px;
		font-size: 12px;
		font-weight: 600;
		text-shadow: 0 1px 2px rgba(255, 255, 255, 0.6);
	}

	/* Windows */
	.window {
		position: absolute;
		display: flex;
		flex-direction: column;
		background: var(--window-bg);
		-webkit-backdrop-filter: blur(24px);
		backdrop-filter: blur(24px);
		border: 1px solid rgba(255, 255, 255, 0.6);
		border-radius: 12px;
		box-shadow: var(--window-shadow);
		overflow: hidden;
		z-index: 1;
		transition: box-shadow 0.2s ease;
	}

	.window.is-focused {
		box-shadow: 0 0 0 0.5px rgba(0, 0, 0, 0.2), 0 30px 70px rgba(31, 29, 43, 0.32);
	}

	.window.is-dragging {
		transition: none;
		user-select: none;
	}

	.window.is-closed {
		display: none;
	}

	.titlebar {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		height: var(--window-titlebar);
		padding: 0 12px;
		flex-shrink: 0;
		border-bottom: 1px solid var(--window-line);
		background: var(--window-bar);
		touch-action: none;
	}

	@media (min-width: 1100px) {
		.titlebar {
			cursor: grab;
		}

		.is-dragging .titlebar {
			cursor: grabbing;
		}
	}

	.lights {
		position: absolute;
		left: 12px;
		display: flex;
		gap: 8px;
	}

	.lights i,
	.light {
		width: 12px;
		height: 12px;
		min-width: 0;
		min-height: 0;
		border-radius: 50%;
		border: 0;
		padding: 0;
		background: var(--os-yellow);
	}

	.lights i:last-child {
		background: var(--os-green);
	}

	.light.close {
		background: var(--os-red);
		cursor: pointer;
	}

	.win-title {
		font-family: var(--font-sans);
		font-size: 13px;
		font-weight: 600;
		letter-spacing: 0;
		color: #4B4860;
	}

	.win-meta {
		position: absolute;
		right: 12px;
		font-size: 12px;
		color: #8A879A;
	}

	.win-body {
		overflow-y: auto;
	}

	.win-about {
		left: 3vw;
		top: 28px;
		width: 400px;
	}

	.about-body {
		padding: 24px 28px 26px;
		text-align: center;
	}

	.about-body img {
		width: 112px;
		height: 112px;
		margin: 0 auto;
		border-radius: 50%;
		object-fit: cover;
		box-shadow: 0 0 0 4px #FFFFFF, 0 0 0 5px rgba(0, 0, 0, 0.08);
	}

	.about-body h1 {
		margin-top: 14px;
		font-family: var(--font-sans);
		font-size: 26px;
		font-weight: 800;
		letter-spacing: -0.02em;
		color: #1F1D2B;
	}

	.about-role {
		margin-bottom: 12px;
		color: #6B6880;
	}

	.about-tagline {
		margin-bottom: 6px;
		font-size: 17px;
		font-weight: 700;
		color: #7C3AED;
	}

	.about-sub {
		margin-bottom: 20px;
		color: #4B4860;
	}

	.about-actions {
		display: flex;
		justify-content: center;
		gap: 8px;
	}

	.mac-btn {
		display: inline-flex;
		align-items: center;
		min-height: 32px;
		padding: 0 14px;
		border-radius: 7px;
		background: #FFFFFF;
		border: 1px solid rgba(0, 0, 0, 0.12);
		box-shadow: 0 1px 1px rgba(0, 0, 0, 0.05);
		font-weight: 500;
	}

	.desktop .mac-btn.primary {
		background: linear-gradient(180deg, #4F8BFF, var(--os-blue));
		border-color: #1D4ED8;
		color: #FFFFFF;
	}

	.mac-btn:hover {
		filter: brightness(0.97);
	}

	.win-finder {
		left: calc(3vw + 430px);
		top: 56px;
		width: min(580px, calc(100vw - 3vw - 430px - 140px));
		height: 410px;
	}

	.finder {
		display: grid;
		grid-template-columns: 150px minmax(0, 1fr);
		min-height: 0;
		flex: 1;
	}

	.finder-side {
		display: flex;
		flex-direction: column;
		gap: 2px;
		padding: 12px 8px;
		background: rgba(240, 238, 248, 0.7);
		border-right: 1px solid rgba(0, 0, 0, 0.06);
		font-size: 13px;
	}

	.finder-side p {
		margin: 8px 8px 4px;
		font-size: 11px;
		font-weight: 700;
		color: #8A879A;
	}

	.finder-side p:first-child {
		margin-top: 0;
	}

	.finder-side a,
	.finder-side span {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 4px 8px;
		border-radius: 6px;
	}

	.finder-side a:hover {
		background: rgba(0, 0, 0, 0.05);
	}

	.desktop .finder-side a.active {
		background: rgba(37, 99, 235, 0.12);
		color: #1D4ED8;
		font-weight: 600;
	}

	.dot {
		width: 10px;
		height: 10px;
		border-radius: 50%;
	}

	.dot.violet { background: #8B5CF6; }
	.dot.amber { background: #F59E0B; }
	.dot.leaf { background: #22C55E; }

	.finder-main {
		display: flex;
		flex-direction: column;
		min-height: 0;
	}

	.finder-head,
	.finder-list a {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 120px 40px;
		gap: 12px;
		align-items: center;
	}

	.finder-head {
		padding: 6px 14px;
		border-bottom: 1px solid rgba(0, 0, 0, 0.06);
		font-size: 11px;
		font-weight: 600;
		color: #8A879A;
	}

	.finder-list {
		list-style: none;
		padding: 4px 6px;
		overflow-y: auto;
	}

	.finder-list li:nth-child(even) a {
		background: rgba(0, 0, 0, 0.025);
	}

	.finder-list a {
		padding: 7px 8px;
		border-radius: 6px;
	}

	.desktop .finder-list a:hover {
		background: var(--os-blue);
		color: #FFFFFF;
	}

	.finder-list a:hover small,
	.finder-list a:hover .f-kind {
		color: rgba(255, 255, 255, 0.8);
	}

	.f-name {
		display: flex;
		align-items: center;
		gap: 10px;
		min-width: 0;
	}

	.f-name span {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}

	.f-name small {
		color: #8A879A;
		font-size: 12px;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.f-icon {
		flex-shrink: 0;
		width: 28px;
		height: 28px;
		border-radius: 7px;
	}

	.hue-violet { background: linear-gradient(160deg, #C4B5FD, #7C3AED); }
	.hue-leaf { background: linear-gradient(160deg, #86EFAC, #16A34A); }
	.hue-amber { background: linear-gradient(160deg, #FDE68A, #D97706); }
	.hue-rose { background: linear-gradient(160deg, #FDA4AF, #E11D48); }
	.hue-sky { background: linear-gradient(160deg, #7DD3FC, #0284C7); }

	.f-kind {
		font-size: 12px;
		color: #6B6880;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.f-stars {
		text-align: right;
		font-variant-numeric: tabular-nums;
		font-weight: 600;
	}

	.win-log {
		left: calc(3vw + 480px);
		top: 500px;
		width: min(520px, calc(100vw - 3vw - 480px - 130px));
		height: 300px;
	}

	.log-body {
		list-style: none;
		padding: 16px 22px;
		font-family: var(--font-mono);
		font-size: 12.5px;
		background: #FFFFFF;
		flex: 1;
	}

	.log-body li {
		margin-bottom: 14px;
