---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import HeroStats from '../components/HeroStats.astro';
import OpenSourceShowcase from '../components/OpenSourceShowcase.astro';
import Timeline from '../components/Timeline.astro';
import { GITHUB_USERNAME, SITE_DESCRIPTION, SITE_TITLE_FULL, SOCIAL_LINKS } from '../consts';
import { buildShowcase } from '../data/showcase';
import { getHomeData } from '../lib/home-data';
import { loadRepositories } from '../lib/projects';

// Render on request so new repos and star counts show up without a redeploy.
// The CDN serves a cached copy for 5 minutes, then refreshes in the background.
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=300, stale-while-revalidate=86400');

const [{ stats, timelineItems }, repositories] = await Promise.all([
	getHomeData(),
	loadRepositories(GITHUB_USERNAME, 100),
]);
const showcase = buildShowcase(repositories);
const latest = timelineItems.find((item) => !item.isPrivate);
const currentlyBuilding = latest ? { name: latest.title, url: latest.repoUrl } : null;

const personSchema = {
	"@context": "https://schema.org",
	"@type": "Person",
	"name": "Michelle Mayes",
	"url": "https://michellemayes.me",
	"jobTitle": "Full-Stack Builder & AI Product Engineer",
	"description": SITE_DESCRIPTION,
	"image": "https://michellemayes.me/avatar.jpg",
	"sameAs": [
		SOCIAL_LINKS.github,
		SOCIAL_LINKS.linkedin,
		SOCIAL_LINKS.twitter,
	],
};
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE_FULL} description={SITE_DESCRIPTION} jsonLd={personSchema} />
  </head>
  <body>
    <Header />
    <main id="main-content">
      <HeroStats stats={stats} currentlyBuilding={currentlyBuilding} />

      <OpenSourceShowcase projects={showcase} />

      <section class="timeline-section">
        <div class="timeline-heading">
          <span class="eyebrow">The Shipping Log</span>
          <h2>Everything else I've shipped</h2>
          <p>Every push, prototype, and late-night experiment, newest first. Expand any card for the details.</p>
        </div>
        <Timeline items={timelineItems} />
      </section>

      <!-- Contact CTA -->
      <section class="contact-section">
        <div class="contact-card">
          <svg class="contact-doodle" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 2v2"/><path d="M14 2v2"/><path d="M6 2v2"/><path d="M16 8a1 1 0 0 1 1 1v8a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V9a1 1 0 0 1 1-1h14a4 4 0 1 1 0 8h-1"/></svg>
          <h2>Let's Build Something</h2>
          <p>Have a project in mind, a wild idea, or just want to talk AI and product development? Grab a coffee with me.</p>
          <a href="https://calendar.app.google/yYSHV4KQ4zJsxkdt5" target="_blank" rel="noopener noreferrer" class="cta-button">
            <span>Schedule a Chat</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>

<style>
  main {
    max-width: 1000px;
    margin: 0 auto;
    padding: var(--space-xl);
  }

  .timeline-section {
    margin-top: var(--space-3xl);
  }

  .timeline-heading {
    text-align: center;
    max-width: 560px;
    margin: 0 auto var(--space-xl);
  }

  .timeline-heading h2 {
    font-family: var(--font-serif);
    font-size: var(--text-fluid-2xl);
    font-weight: 700;
    color: var(--text);
    margin-bottom: var(--space-sm);
  }

  .timeline-heading p {
    color: var(--text-muted);
    font-size: var(--text-base);
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-dark);
    background: var(--accent-50);
    border: 1px dashed var(--accent-300);
    padding: 4px 12px;
    border-radius: var(--radius-full);
    margin-bottom: var(--space-md);
  }

  .contact-doodle {
    display: inline-block;
    color: var(--warm);
    margin-bottom: var(--space-sm);
    transform: rotate(-8deg);
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .contact-card:hover .contact-doodle {
    transform: rotate(8deg) scale(1.15);
  }

  @media (max-width: 768px) {
    main {
      padding: var(--space-lg);
    }

  }

  @media (max-width: 480px) {
    main {
      padding: var(--space-md);
    }
  }

  /* Contact Section */
  .contact-section {
    margin-top: var(--space-3xl);
    padding: var(--space-2xl) 0;
  }

  .contact-card {
    background: linear-gradient(135deg, var(--bg-card), var(--warm-50));
    border: 1px solid var(--warm-100);
    border-radius: var(--radius-xl);
    padding: var(--space-2xl) var(--space-xl);
    text-align: center;
    box-shadow: var(--shadow-lg);
  }

  .contact-section h2 {
    font-family: var(--font-serif);
    font-size: var(--text-fluid-2xl);
    font-weight: 700;
    color: var(--text);
    margin-bottom: var(--space-md);
  }

  .contact-section p {
    color: var(--text-muted);
    font-size: var(--text-lg);
    max-width: 500px;
    margin: 0 auto var(--space-xl) auto;
    line-height: var(--leading-relaxed);
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    background: var(--warm);
    color: white;
    padding: var(--space-md) var(--space-xl);
    border-radius: 12px;
    font-weight: 600;
    font-size: var(--text-lg);
    text-decoration: none;
    transition: background-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
    box-shadow: 0 4px 20px rgba(217, 119, 6, 0.2);
    min-height: 44px;
  }

  .cta-button:hover {
    background: var(--warm-dark);
    color: white;
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(217, 119, 6, 0.3);
  }

  .cta-button:active {
    transform: scale(0.98);
  }

  .cta-button svg {
    transition: transform 0.3s ease;
  }

  .cta-button:hover svg {
    transform: translateX(4px);
  }

  @media (max-width: 768px) {
    .contact-card {
      padding: var(--space-xl) var(--space-lg);
    }

    .contact-section p {
      font-size: var(--text-base);
    }

    .cta-button {
      padding: var(--space-md) var(--space-lg);
      font-size: var(--text-base);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-card:hover .contact-doodle {
      transform: rotate(-8deg);
    }
  }
</style>
