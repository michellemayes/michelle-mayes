---
import OsPage from '../layouts/OsPage.astro';
import { SITE_TITLE } from '../consts';

export const prerender = true;
---

<OsPage
  title={`Page not found | ${SITE_TITLE}`}
  description="That page couldn't be found on michellemayes.me."
  windowTitle="Finder"
  size="dialog"
>
  <div class="dialog" role="alert">
    <span class="dialog-icon" aria-hidden="true">
      <svg viewBox="0 0 64 64">
        <path d="M8 18a4 4 0 0 1 4-4h14l5 5h21a4 4 0 0 1 4 4v25a4 4 0 0 1-4 4H12a4 4 0 0 1-4-4z" fill="url(#folder)" />
        <circle cx="46" cy="44" r="13" fill="#FEBC2E" stroke="#fff" stroke-width="3" />
        <path d="M46 37v8M46 50v.5" stroke="#5C3B00" stroke-width="3.5" stroke-linecap="round" />
        <defs>
          <linearGradient id="folder" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#7DD3FC" />
            <stop offset="1" stop-color="#3B82F6" />
          </linearGradient>
        </defs>
      </svg>
    </span>
    <h1>This page can't be opened.</h1>
    <p>It may have been moved, renamed, or never existed. Everything that does exist is on the desktop.</p>
    <div class="dialog-actions">
      <a class="mac-btn" href="/projects">Browse projects</a>
      <a class="mac-btn primary" href="/">Go to the desktop</a>
    </div>
  </div>
</OsPage>

<style>
  .dialog {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 28px 28px 24px;
    text-align: center;
  }

  .dialog-icon svg {
    width: 72px;
    height: 72px;
    filter: drop-shadow(0 6px 10px rgba(31, 29, 43, 0.18));
  }

  h1 {
    margin-top: 14px;
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--os-ink);
  }

  p {
    margin-top: 6px;
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--os-subtle);
  }

  .dialog-actions {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
    width: 100%;
    margin-top: 22px;
  }

  @media (max-width: 420px) {
    .dialog-actions {
      flex-direction: column-reverse;
    }
  }
</style>
