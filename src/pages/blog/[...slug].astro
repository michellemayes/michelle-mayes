---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import OsPage from '../../layouts/OsPage.astro';
import { SITE_TITLE } from '../../consts';
import { formatPostDate, readingTime } from '../../lib/reading-time';

// Prerender blog posts as static pages
export const prerender = true;

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.slug },
		props: post,
	}));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await render(post);
const minutes = readingTime(post.body);

const blogPostSchema = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	"headline": post.data.title,
	"description": post.data.description,
	"datePublished": post.data.pubDate.toISOString(),
	...(post.data.updatedDate && { "dateModified": post.data.updatedDate.toISOString() }),
	"author": {
		"@type": "Person",
		"name": "Michelle Mayes",
		"url": "https://michellemayes.me",
	},
	"publisher": {
		"@type": "Person",
		"name": "Michelle Mayes",
	},
	"mainEntityOfPage": {
		"@type": "WebPage",
		"@id": `https://michellemayes.me/blog/${post.slug}/`,
	},
};
---

<OsPage
	title={`${post.data.title} - ${SITE_TITLE}`}
	description={post.data.description}
	jsonLd={blogPostSchema}
	windowTitle={post.data.title}
	meta={`${minutes} min read`}
	size="m"
>
	<div class="win-toolbar" slot="toolbar">
		<a href="/blog" class="mac-btn">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
			All posts
		</a>
		<span class="spacer"></span>
		<span class="toolbar-tags">
			{(post.data.tags ?? []).map((tag: string) => <span class="os-pill">{tag}</span>)}
		</span>
	</div>

	<div class="canvas">
		<article class="blog-post">
			<header class="blog-post-header">
				<p class="blog-post-meta">
					<time datetime={post.data.pubDate.toISOString()}>{formatPostDate(post.data.pubDate)}</time>
					<span aria-hidden="true">·</span>
					<span>{minutes} min read</span>
				</p>
				<h1>{post.data.title}</h1>
				{post.data.description && (
					<p class="blog-post-description">{post.data.description}</p>
				)}
			</header>

			<div class="blog-post-content">
				<Content />
			</div>

			<footer class="author-bio">
				<img src="/avatar.jpg" alt="Michelle Mayes" class="author-avatar" width="56" height="56" loading="lazy" />
				<div class="author-info">
					<strong>Michelle Mayes</strong>
					<p>Data scientist and AI product engineer building intelligent systems with RAG, LLMs, and modern web stacks.</p>
				</div>
				<div class="author-actions">
					<a class="mac-btn" href="/about">About me</a>
					<a class="mac-btn primary" href="https://calendar.app.google/yYSHV4KQ4zJsxkdt5" target="_blank" rel="noopener noreferrer">Schedule a chat</a>
				</div>
			</footer>
		</article>
	</div>
</OsPage>

<style>
	.toolbar-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 4px;
	}

	/* A white page on a gray canvas, like a document in Pages. */
	.canvas {
		padding: 32px;
		background: var(--os-canvas);
	}

	.blog-post {
		max-width: 680px;
		margin: 0 auto;
		padding: 48px 56px;
		background: #FFFFFF;
		border-radius: 6px;
		box-shadow: 0 0 0 0.5px rgba(0, 0, 0, 0.08), 0 8px 24px rgba(31, 29, 43, 0.08);
	}

	.blog-post-header {
		padding-bottom: 28px;
		margin-bottom: 32px;
		border-bottom: 1px solid rgba(0, 0, 0, 0.08);
	}

	.blog-post-meta {
		display: flex;
		gap: 8px;
		font-size: 13px;
		font-weight: 500;
		color: var(--os-muted);
	}

	.blog-post-header h1 {
		margin-top: 10px;
		font-size: clamp(1.9rem, 1.5rem + 1.6vw, 2.6rem);
		font-weight: 800;
		line-height: 1.12;
		letter-spacing: -0.03em;
		color: var(--os-ink);
	}

	.blog-post-description {
		margin-top: 14px;
		font-size: 18px;
		line-height: 1.6;
		color: var(--os-subtle);
	}

	.blog-post-content {
		font-size: 17px;
		line-height: 1.8;
		color: #2A2838;
	}

	.blog-post-content :global(h2) {
		margin-top: 2.2em;
		margin-bottom: 0.6em;
		font-size: 1.5rem;
		font-weight: 800;
		letter-spacing: -0.02em;
		color: var(--os-ink);
	}

	.blog-post-content :global(h3) {
		margin-top: 1.8em;
		margin-bottom: 0.5em;
		font-size: 1.2rem;
		font-weight: 700;
		color: var(--os-ink);
	}

	.blog-post-content :global(p) {
		margin-bottom: 1.4em;
	}

	.blog-post-content :global(ul),
	.blog-post-content :global(ol) {
		margin-bottom: 1.4em;
		padding-left: 1.4em;
	}

	.blog-post-content :global(li) {
		margin-bottom: 0.45em;
	}

	.blog-post-content :global(li::marker) {
		color: #7C3AED;
	}

	.blog-post-content :global(code) {
		padding: 2px 6px;
		border-radius: 5px;
		background: rgba(124, 58, 237, 0.08);
		font-family: var(--font-mono);
		font-size: 0.88em;
		color: #6D28D9;
	}

	/* Code blocks look like a little Terminal window. */
	.blog-post-content :global(pre) {
		position: relative;
		margin-bottom: 1.4em;
		padding: 38px 18px 16px;
		border-radius: 10px;
		background: #1C1A27;
		color: #E6E1F5;
		font-size: 14px;
		line-height: 1.6;
		overflow-x: auto;
		box-shadow: 0 10px 24px rgba(31, 29, 43, 0.18);
	}

	.blog-post-content :global(pre)::before {
		content: '';
		position: absolute;
		top: 13px;
		left: 14px;
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--os-red);
		box-shadow: 16px 0 0 var(--os-yellow), 32px 0 0 var(--os-green);
	}

	.blog-post-content :global(pre code) {
		padding: 0;
		background: none;
		color: inherit;
		font-size: inherit;
	}

	.blog-post-content :global(blockquote) {
		margin: 1.6em 0;
		padding: 14px 18px;
		border-left: 3px solid #7C3AED;
		border-radius: 0 8px 8px 0;
		background: rgba(124, 58, 237, 0.06);
		font-style: normal;
		color: #4B4860;
	}

	.blog-post-content :global(blockquote p:last-child) {
		margin-bottom: 0;
	}

	.blog-post-content :global(hr) {
		margin: 2.4em 0;
		border: 0;
		border-top: 1px solid rgba(0, 0, 0, 0.1);
	}

	.blog-post-content :global(img) {
		margin: 1.6em 0;
		border-radius: 10px;
		box-shadow: 0 8px 24px rgba(31, 29, 43, 0.12);
	}

	.blog-post-content :global(table) {
		width: 100%;
		margin-bottom: 1.4em;
		border-collapse: collapse;
		font-size: 15px;
	}

	.blog-post-content :global(th),
	.blog-post-content :global(td) {
		padding: 8px 10px;
		border-bottom: 1px solid rgba(0, 0, 0, 0.08);
		text-align: left;
	}

	.blog-post-content :global(th) {
		font-weight: 700;
		color: var(--os-ink);
	}

	.blog-post-content :global(a) {
		color: var(--os-blue);
		text-decoration: underline;
		text-decoration-color: rgba(37, 99, 235, 0.3);
		text-underline-offset: 2px;
		transition: text-decoration-color 0.2s ease;
	}

	.blog-post-content :global(a:hover) {
		color: var(--os-blue);
		text-decoration-color: var(--os-blue);
	}

	.author-bio {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 14px;
		margin-top: 40px;
		padding: 18px;
		border-radius: 12px;
		background: var(--os-canvas);
	}

	.author-avatar {
		width: 56px;
		height: 56px;
		border-radius: 50%;
		object-fit: cover;
		flex-shrink: 0;
		box-shadow: 0 0 0 3px #FFFFFF;
	}

	.author-info {
		flex: 1;
		min-width: 200px;
		font-size: 14px;
		line-height: 1.5;
	}

	.author-info p {
		color: var(--os-subtle);
	}

	.author-actions {
		display: flex;
		gap: 8px;
	}

	@media (max-width: 760px) {
		.canvas {
			padding: 12px;
		}

		.blog-post {
			padding: 28px 20px;
		}

		.blog-post-content {
			font-size: 16.5px;
		}

		.toolbar-tags {
			display: none;
		}
	}
</style>
