---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import Desktop from '../../layouts/Desktop.astro';
import Window from '../../components/Window.astro';
import { SITE_TITLE } from '../../consts';
import { formatPostDate, readingTime } from '../../lib/reading-time';

// Prerender blog posts as static pages
export const prerender = true;

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.slug },
		props: post,
	}));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await render(post);
const minutes = readingTime(post.body);

const blogPostSchema = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	"headline": post.data.title,
	"description": post.data.description,
	"datePublished": post.data.pubDate.toISOString(),
	...(post.data.updatedDate && { "dateModified": post.data.updatedDate.toISOString() }),
	"author": {
		"@type": "Person",
		"name": "Michelle Mayes",
		"url": "https://michellemayes.me",
	},
	"publisher": {
		"@type": "Person",
		"name": "Michelle Mayes",
	},
	"mainEntityOfPage": {
		"@type": "WebPage",
		"@id": `https://michellemayes.me/blog/${post.slug}/`,
	},
};
---

<Desktop
  title={`${post.data.title} - ${SITE_TITLE}`}
  description={post.data.description}
  jsonLd={blogPostSchema}
  appName="Notes"
>
  <Window
    id={`post-${post.slug}`}
    title={post.data.title}
    titleAs="p"
    route={`/blog/${post.slug}`}
    appName="Notes"
    docTitle={`${post.data.title} - ${SITE_TITLE}`}
    meta={`${minutes} min read`}
    width={840}
    height={880}
    icon={{ color: 'linear-gradient(160deg, #FDE68A, #F59E0B)', glyph: 'M7 3h7l5 5v13H7zM14 3v5h5M10 13h6M10 17h6' }}
    primary
    class="app-post"
  >
	<div class="win-toolbar" slot="toolbar">
		<a href="/blog" class="mac-btn">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
			All posts
		</a>
		<span class="spacer"></span>
		<span class="toolbar-tags">
			{(post.data.tags ?? []).map((tag: string) => <span class="os-pill">{tag}</span>)}
		</span>
	</div>

	<div class="canvas">
		<article class="blog-post">
			<header class="blog-post-header">
				<p class="blog-post-meta">
					<time datetime={post.data.pubDate.toISOString()}>{formatPostDate(post.data.pubDate)}</time>
					<span aria-hidden="true">·</span>
					<span>{minutes} min read</span>
				</p>
				<h1>{post.data.title}</h1>
				{post.data.description && (
					<p class="blog-post-description">{post.data.description}</p>
				)}
			</header>

			<div class="blog-post-content">
				<Content />
			</div>

			<footer class="author-bio">
				<img src="/avatar.jpg" alt="Michelle Mayes" class="author-avatar" width="56" height="56" loading="lazy" />
				<div class="author-info">
					<strong>Michelle Mayes</strong>
					<p>Data scientist and AI product engineer building intelligent systems with RAG, LLMs, and modern web stacks.</p>
				</div>
				<div class="author-actions">
					<a class="mac-btn" href="/about">About me</a>
					<a class="mac-btn primary" href="https://calendar.app.google/yYSHV4KQ4zJsxkdt5" target="_blank" rel="noopener noreferrer">Schedule a chat</a>
				</div>
			</footer>
		</article>
	</div>
  </Window>
</Desktop>
