---
import { getCollection } from 'astro:content';
import Desktop from '../../layouts/Desktop.astro';
import Window from '../../components/Window.astro';
import { SITE_TITLE } from '../../consts';
import { formatPostDate, readingTime } from '../../lib/reading-time';

export const prerender = true;

const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);

const tagCounts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags ?? []) tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
}
const tags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<Desktop
  title={`Blog | ${SITE_TITLE}`}
  description="Thoughts on shipping fast, AI-assisted development, and building in public from Michelle Mayes."
  appName="Notes"
>
  <Window
    id="app-blog"
    title="Blog"
    titleAs="p"
    route="/blog"
    appName="Notes"
    docTitle={`Blog | ${SITE_TITLE}`}
    meta={`${posts.length} posts`}
    width={1000}
    height={700}
    icon={{ color: 'linear-gradient(160deg, #FDE68A, #F59E0B)', glyph: 'M7 4h10v16H7zM9.5 8h5M9.5 12h5M9.5 16h3' }}
    primary
    class="app-blog"
  >
  <div class="os-split notes" data-filter-root>
    <nav class="os-sidebar" aria-label="Filter posts">
      <p class="os-sidebar-label">Library</p>
      <button type="button" class="os-sidebar-item" data-filter="" aria-pressed="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h6l2 2h8v10H4z" /></svg>
        All Posts<span class="count">{posts.length}</span>
      </button>

      {tags.length > 0 && <p class="os-sidebar-label">Tags</p>}
      {tags.map(([tag, count]) => (
        <button type="button" class="os-sidebar-item" data-filter={tag} aria-pressed="false">
          <span class="hash" aria-hidden="true">#</span>{tag}<span class="count">{count}</span>
        </button>
      ))}

      <p class="os-sidebar-label">Subscribe</p>
      <a class="os-sidebar-item" href="/rss.xml">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 19h.01M5 12a7 7 0 0 1 7 7M5 5a14 14 0 0 1 14 14" /></svg>
        RSS feed
      </a>
    </nav>

    <div class="pane">
      <header class="pane-head">
        <h1 class="os-heading">Blog</h1>
        <p class="os-subtitle">Thoughts on shipping fast, AI-assisted development, and building in public.</p>
      </header>

      <ul class="post-list">
        {posts.map((post) => (
          <li data-filter-tags={(post.data.tags ?? []).join('|')}>
            <a href={`/blog/${post.slug}/`} class="post">
              <span class="post-top">
                <span class="post-title">{post.data.title}</span>
                <time datetime={post.data.pubDate.toISOString()}>{formatPostDate(post.data.pubDate)}</time>
              </span>
              {post.data.description && <span class="post-desc">{post.data.description}</span>}
              <span class="post-meta">
                <span class="read">{readingTime(post.body)} min read</span>
                {(post.data.tags ?? []).slice(0, 3).map((tag: string) => <span class="os-pill">{tag}</span>)}
              </span>
            </a>
          </li>
        ))}
      </ul>

      <p class="empty" data-filter-empty hidden>No posts with that tag yet.</p>
    </div>
  </div>
  </Window>
</Desktop>

