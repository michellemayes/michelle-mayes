---
import DesignHead from '../../components/designs/DesignHead.astro';
import DesignSwitcher from '../../components/designs/DesignSwitcher.astro';
import { NAV_LINKS, PROFILE, formatShortDate, getDesignData } from '../../lib/design-data';

export const prerender = true;

const { stats, timeline, showcase, currentlyBuilding, totalStars } = getDesignData();
const [spotlight, ...rest] = showcase;
const languages = Object.entries(stats.languageBreakdown);
const langColors = ['#8B5CF6', '#F59E0B', '#22C55E', '#38BDF8', '#F472B6', '#94A3B8'];
---

<!doctype html>
<html lang="en">
  <head>
    <DesignHead
      title="Bento"
      themeColor="#F3F1FA"
      fonts="family=Plus+Jakarta+Sans:wght@400;500;600;700;800"
    />
  </head>
  <body>
    <header class="topbar">
      <a href="/" class="brand"><span class="brand-dot" aria-hidden="true"></span>Michelle Mayes</a>
      <nav aria-label="Main navigation">
        {NAV_LINKS.map(({ href, label }) => <a href={href}>{label}</a>)}
      </nav>
    </header>

    <main class="grid">
      <section class="tile intro">
        {currentlyBuilding && (
          <a class="now" href={currentlyBuilding.repoUrl}>
            <span class="now-dot" aria-hidden="true"></span>
            Tinkering on <strong>{currentlyBuilding.title}</strong>
          </a>
        )}
        <h1>{PROFILE.tagline}</h1>
        <p>{PROFILE.subline}</p>
        <div class="intro-actions">
          <a class="btn primary" href="#work">See the work</a>
          <a class="btn" href="/resume">Resume</a>
        </div>
      </section>

      <figure class="tile photo">
        <img src={PROFILE.avatar} alt="Michelle Mayes" width="480" height="480" loading="eager" />
        <figcaption>
          <strong>{PROFILE.name}</strong>
          <span>{PROFILE.role}</span>
        </figcaption>
      </figure>

      <div class="tile stat">
        <span class="stat-value">{stats.totalRepos}</span>
        <span class="stat-label">Projects shipped</span>
      </div>

      <div class="tile stat stat-warm">
        <span class="stat-value">{totalStars}<small>★</small></span>
        <span class="stat-label">Stars on showcase</span>
      </div>

      <div class="tile langs">
        <h2 class="tile-label">Writes mostly in</h2>
        <div class="lang-bar" role="img" aria-label={languages.map(([n, p]) => `${n} ${p}%`).join(', ')}>
          {languages.map(([, percent], i) => (
            <span style={`flex: ${percent}; background: ${langColors[i % langColors.length]}`}></span>
          ))}
        </div>
        <ul>
          {languages.map(([name, percent], i) => (
            <li><i style={`background: ${langColors[i % langColors.length]}`}></i>{name}<span>{percent}%</span></li>
          ))}
        </ul>
      </div>

      {spotlight && (
        <a class={`tile spotlight hue-${spotlight.hue}`} href={spotlight.url} id="work">
          <span class="tile-label">Most starred · ★ {spotlight.stars}</span>
          <h2>{spotlight.name}</h2>
          <p class="spot-tagline">{spotlight.tagline}</p>
          <p>{spotlight.pitch}</p>
          <ul class="chips">{spotlight.stack.map((s) => <li>{s}</li>)}</ul>
          <span class="arrow" aria-hidden="true">↗</span>
        </a>
      )}

      {rest.map((project) => (
        <a class={`tile mini hue-${project.hue}`} href={project.url}>
          <span class="tile-label">{project.stack[0]}</span>
          <h3>{project.name}</h3>
          <p>{project.tagline}</p>
          <span class="mini-foot">{project.stars > 0 ? `★ ${project.stars}` : 'New'}<span aria-hidden="true">↗</span></span>
        </a>
      ))}

      <section class="tile log" aria-labelledby="log-title">
        <div class="log-head">
          <h2 class="tile-label" id="log-title">Shipping log</h2>
          <a href="/projects">All projects →</a>
        </div>
        <ol>
          {timeline.map((item) => (
            <li>
              <a href={item.repoUrl}>
                <span class="log-title">{item.title}</span>
                <span class="log-date">{formatShortDate(item.date)}</span>
                <span class="log-desc">{item.description}</span>
              </a>
            </li>
          ))}
        </ol>
      </section>

      <section class="tile contact">
        <h2>Let’s build something.</h2>
        <p>A project, a wild idea, or just a chat about AI and product. Coffee’s on me.</p>
        <a class="btn light" href={PROFILE.calendarUrl} target="_blank" rel="noopener noreferrer">Schedule a chat →</a>
      </section>

      <nav class="tile socials" aria-label="Social links">
        <a href={PROFILE.social.github}>GitHub <span aria-hidden="true">↗</span></a>
        <a href={PROFILE.social.linkedin}>LinkedIn <span aria-hidden="true">↗</span></a>
        <a href={PROFILE.social.twitter}>X / Twitter <span aria-hidden="true">↗</span></a>
        <a href={PROFILE.email}>Email <span aria-hidden="true">↗</span></a>
      </nav>
    </main>

    <DesignSwitcher slug="bento" />
  </body>
</html>

<style>
  :global(*),
  :global(*::before),
  :global(*::after) {
    box-sizing: border-box;
  }

  :global(:root) {
    --bg: #F3F1FA;
    --tile: #FFFFFF;
    --tile-alt: #FBFAFE;
    --ink: #1E1B2E;
    --muted: #6B6680;
    --line: #E7E3F3;
    --accent: #8B5CF6;
    --accent-ink: #6D28D9;
    --warm: #F59E0B;
    --violet-bg: #EDE9FE;
    --leaf-bg: #DCFCE7;
    --amber-bg: #FEF3C7;
    --rose-bg: #FFE4E6;
    --sky-bg: #E0F2FE;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root) {
      --bg: #0F0D17;
      --tile: #1A1726;
      --tile-alt: #1F1B2E;
      --ink: #F1EEFB;
      --muted: #A39DB8;
      --line: #2B2640;
      --accent: #A78BFA;
      --accent-ink: #C4B5FD;
      --violet-bg: #2A2145;
      --leaf-bg: #15291E;
      --amber-bg: #2E2414;
      --rose-bg: #2E1A22;
      --sky-bg: #142435;
    }
  }

  :global(body) {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-size: 15px;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
    padding-bottom: 88px;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 8px;
  }

  .topbar {
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px 20px 4px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 800;
    font-size: 17px;
  }

  .brand-dot {
    width: 14px;
    height: 14px;
    border-radius: 5px;
    background: linear-gradient(135deg, var(--accent), var(--warm));
  }

  .topbar nav {
    display: flex;
    gap: 4px;
    background: var(--tile);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 4px;
  }

  .topbar nav a {
    padding: 6px 14px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 14px;
    color: var(--muted);
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .topbar nav a:hover {
    background: var(--violet-bg);
    color: var(--ink);
  }

  .grid {
    max-width: 1200px;
    margin: 0 auto;
    padding: 16px 20px;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-flow: dense;
    gap: 16px;
  }

  .tile {
    position: relative;
    margin: 0;
    background: var(--tile);
    border: 1px solid var(--line);
    border-radius: 24px;
    padding: 24px;
    overflow: hidden;
  }

  a.tile {
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.2s ease;
  }

  a.tile:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 30px rgba(30, 27, 46, 0.1);
  }

  .tile-label {
    display: block;
    margin: 0 0 10px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .intro {
    grid-column: span 2;
    grid-row: span 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 32px;
    background:
      radial-gradient(circle at 100% 0%, var(--violet-bg), transparent 55%),
      var(--tile);
  }

  .now {
    position: absolute;
    top: 24px;
    left: 32px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--tile-alt);
    border: 1px solid var(--line);
    font-size: 13px;
  }

  .now-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22C55E;
    box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.5);
    animation: ping 2s ease-out infinite;
  }

  @keyframes ping {
    70% { box-shadow: 0 0 0 8px rgba(34, 197, 94, 0); }
    100% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0); }
  }

  .intro h1 {
    margin: 64px 0 12px;
    font-size: clamp(2.2rem, 4.6vw, 3.6rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    font-weight: 800;
  }

  .intro p {
    margin: 0 0 24px;
    font-size: 17px;
    color: var(--muted);
    max-width: 480px;
  }

  .intro-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 20px;
    border-radius: 14px;
    font-weight: 700;
    border: 1px solid var(--line);
    background: var(--tile);
    transition: transform 0.15s ease, background-color 0.15s ease;
  }

  .btn:hover {
    transform: translateY(-1px);
  }

  .btn.primary {
    background: var(--ink);
    color: var(--bg);
    border-color: var(--ink);
  }

  .btn.light {
    background: #FFFFFF;
    color: #1E1B2E;
    border-color: transparent;
  }

  .photo {
    grid-row: span 2;
    padding: 0;
  }

  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .photo figcaption {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 12px;
    padding: 12px 14px;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: #1E1B2E;
    display: flex;
    flex-direction: column;
    font-size: 13px;
  }

  .photo figcaption strong {
    font-size: 15px;
  }

  .stat {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 150px;
  }

  .stat-value {
    font-size: 56px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--accent-ink);
  }

  .stat-value small {
    font-size: 28px;
    margin-left: 4px;
  }

  .stat-warm {
    background: var(--amber-bg);
  }

  .stat-warm .stat-value {
    color: #B45309;
  }

  .stat-label {
    font-weight: 600;
    color: var(--muted);
  }

  .langs {
    grid-column: span 2;
  }

  .lang-bar {
    display: flex;
    gap: 3px;
    height: 14px;
    border-radius: 999px;
    overflow: hidden;
    margin-bottom: 14px;
  }

  .langs ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    font-size: 14px;
    font-weight: 600;
  }

  .langs li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .langs li i {
    width: 10px;
    height: 10px;
    border-radius: 3px;
  }

  .langs li span {
    color: var(--muted);
    font-weight: 500;
  }

  .hue-violet { background: var(--violet-bg); }
  .hue-leaf { background: var(--leaf-bg); }
  .hue-amber { background: var(--amber-bg); }
  .hue-rose { background: var(--rose-bg); }
  .hue-sky { background: var(--sky-bg); }

  .spotlight {
    grid-column: span 2;
    grid-row: span 2;
    padding: 32px;
    display: flex;
    flex-direction: column;
  }

  .spotlight h2 {
    margin: 0;
    font-size: clamp(2rem, 3.6vw, 2.8rem);
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .spot-tagline {
    margin: 6px 0 14px;
    font-size: 19px;
    font-weight: 700;
    color: var(--accent-ink);
  }

  .spotlight p:not(.spot-tagline) {
    margin: 0 0 20px;
    font-size: 16px;
    max-width: 440px;
  }

  .chips {
    list-style: none;
    margin: auto 0 0;
    padding: 0;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .chips li {
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--tile);
    font-size: 13px;
    font-weight: 600;
  }

  .arrow {
    position: absolute;
    top: 24px;
    right: 24px;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--ink);
    color: var(--bg);
    font-size: 20px;
    transition: transform 0.2s ease;
  }

  .spotlight:hover .arrow {
    transform: rotate(45deg);
  }

  .mini {
    display: flex;
    flex-direction: column;
    min-height: 190px;
  }

  .mini h3 {
    margin: 0 0 4px;
    font-size: 20px;
    letter-spacing: -0.02em;
  }

  .mini p {
    margin: 0 0 16px;
    color: var(--muted);
    font-size: 14px;
  }

  .mini-foot {
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    font-weight: 700;
    font-size: 14px;
  }

  .log {
    grid-column: span 2;
    grid-row: span 2;
    display: flex;
    flex-direction: column;
    padding-bottom: 8px;
  }

  .log-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .log-head a {
    font-size: 13px;
    font-weight: 700;
    color: var(--accent-ink);
  }

  .log ol {
    list-style: none;
    margin: 0 -24px;
    padding: 0 24px;
    overflow-y: auto;
    max-height: 420px;
    mask-image: linear-gradient(to bottom, black 85%, transparent);
    -webkit-mask-image: linear-gradient(to bottom, black 85%, transparent);
  }

  .log li a {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2px 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
  }

  .log li a:hover .log-title {
    color: var(--accent-ink);
  }

  .log-title {
    font-weight: 700;
  }

  .log-date {
    font-size: 12px;
    color: var(--muted);
    white-space: nowrap;
  }

  .log-desc {
    grid-column: 1 / -1;
    font-size: 13px;
    color: var(--muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .contact {
    grid-column: span 2;
    background: linear-gradient(135deg, #7C3AED, #A855F7 60%, #F59E0B);
    color: #FFFFFF;
    border: 0;
    padding: 32px;
  }

  .contact h2 {
    margin: 0 0 8px;
    font-size: 30px;
    letter-spacing: -0.03em;
  }

  .contact p {
    margin: 0 0 20px;
    opacity: 0.9;
    max-width: 380px;
  }

  .socials {
    grid-column: span 2;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    padding: 16px;
  }

  .socials a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 16px;
    border-radius: 14px;
    background: var(--tile-alt);
    border: 1px solid var(--line);
    font-weight: 700;
    transition: background-color 0.15s ease;
  }

  .socials a:hover {
    background: var(--violet-bg);
  }

  @media (max-width: 1000px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .photo {
      grid-row: span 1;
      aspect-ratio: 1;
    }
  }

  @media (max-width: 600px) {
    .topbar {
      padding: 16px 16px 4px;
    }

    .topbar nav {
      width: 100%;
      justify-content: space-between;
    }

    .topbar nav a {
      padding: 6px 10px;
    }

    .grid {
      grid-template-columns: 1fr;
      padding: 12px 16px;
      gap: 12px;
    }

    .tile,
    .intro,
    .spotlight,
    .contact {
      grid-column: auto;
      grid-row: auto;
      padding: 22px;
    }

    .intro h1 {
      margin-top: 56px;
    }

    .now {
      left: 22px;
      top: 20px;
    }

    .socials {
      grid-column: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .now-dot {
      animation: none;
    }

    a.tile,
    a.tile:hover {
      transition: none;
      transform: none;
    }
  }
</style>
