---
import DesignHead from '../../components/designs/DesignHead.astro';
import DesignSwitcher from '../../components/designs/DesignSwitcher.astro';
import { NAV_LINKS, PROFILE, formatShortDate, getDesignData } from '../../lib/design-data';

export const prerender = true;

const { stats, timeline, showcase, currentlyBuilding, totalStars } = getDesignData();
const [lead, ...features] = showcase;
const today = new Date().toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });
const languages = Object.entries(stats.languageBreakdown);
---

<!doctype html>
<html lang="en">
  <head>
    <DesignHead
      title="The Editorial"
      themeColor="#F4EFE6"
      fonts="family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&family=Inter:wght@500;700"
    />
  </head>
  <body>
    <div class="paper">
      <div class="topline">
        <span>Online Edition</span>
        <span class="topline-date">{today}</span>
        <nav aria-label="Main navigation">
          {NAV_LINKS.map(({ href, label }) => <a href={href}>{label}</a>)}
        </nav>
      </div>

      <header class="masthead">
        <h1><a href="/">The Mayes Dispatch</a></h1>
        <p class="motto">“All the code that’s fit to ship”</p>
      </header>

      <div class="dateline">
        <span>{PROFILE.role}</span>
        <span>{stats.totalRepos} projects · {totalStars} stars</span>
        {currentlyBuilding && <span>Now: <a href={currentlyBuilding.repoUrl}>{currentlyBuilding.title}</a></span>}
      </div>

      <main>
        <section class="front">
          <article class="lead-story">
            <p class="kicker">Profile</p>
            <h2 class="headline">{PROFILE.tagline}</h2>
            <p class="dek">{PROFILE.subline}</p>
            <p class="byline">By Michelle Mayes</p>
            <div class="lead-body">
              <p class="dropcap">
                Most portfolios list what someone can do. This one tracks what actually got shipped. From a monitoring
                tool that opens its own pull requests to a Chrome extension that fills a grocery cart while the coffee
                brews, every project here started as a small annoyance and ended as working software.
              </p>
              <p>
                The through-line is product sense paired with an AI-assisted workflow: write the spec, build the thing,
                measure whether it helped, then move on to the next one. The record of that loop is below, newest first.
              </p>
              <div class="lead-actions">
                <a href={PROFILE.calendarUrl} target="_blank" rel="noopener noreferrer">Schedule a chat &rarr;</a>
                <a href="/resume">Read the résumé &rarr;</a>
              </div>
            </div>
          </article>

          <aside class="front-rail">
            <figure class="portrait">
              <img src={PROFILE.avatar} alt="Michelle Mayes" width="360" height="360" loading="eager" />
              <figcaption>Michelle Mayes, photographed somewhere between a commit and a deploy.</figcaption>
            </figure>
            <div class="numbers">
              <h3>By the Numbers</h3>
              <dl>
                <div><dt>Projects on GitHub</dt><dd>{stats.totalRepos}</dd></div>
                <div><dt>Updated this month</dt><dd>{stats.recentActivity}</dd></div>
                <div><dt>Stars on showcased work</dt><dd>{totalStars}</dd></div>
              </dl>
              <ul class="lang-list">
                {languages.map(([name, percent]) => (
                  <li><span>{name}</span><span class="leader"></span><span>{percent}%</span></li>
                ))}
              </ul>
            </div>
          </aside>
        </section>

        <section class="section" aria-labelledby="oss-title">
          <h2 class="section-title" id="oss-title"><span>Open Source</span></h2>

          {lead && (
            <article class="feature-lead">
              <div>
                <p class="kicker">Above the fold · ★ {lead.stars}</p>
                <h3><a href={lead.url}>{lead.name}: {lead.tagline}</a></h3>
                <p class="feature-pitch">{lead.pitch}</p>
                <p class="meta">Filed under {lead.stack.join(', ')}</p>
              </div>
              <blockquote>“{lead.tagline}”</blockquote>
            </article>
          )}

          <div class="feature-grid">
            {features.map((project) => (
              <article class="feature">
                <p class="kicker">{project.stack[0]}{project.stars > 0 && ` · ★ ${project.stars}`}</p>
                <h3><a href={project.url}>{project.name}</a></h3>
                <p class="feature-tagline">{project.tagline}</p>
                <p>{project.pitch}</p>
              </article>
            ))}
          </div>
        </section>

        <section class="section" aria-labelledby="log-title">
          <h2 class="section-title" id="log-title"><span>The Shipping Log</span></h2>
          <p class="section-dek">A complete record of releases, prototypes, and late-night experiments.</p>
          <ol class="classifieds">
            {timeline.map((item) => (
              <li>
                <time datetime={item.date}>{formatShortDate(item.date)}</time>
                <h3><a href={item.repoUrl}>{item.title}</a></h3>
                <p>{item.description}</p>
                {item.language && <span class="lang">{item.language}</span>}
              </li>
            ))}
          </ol>
        </section>

        <section class="letters">
          <div>
            <h2>Letters to the Editor</h2>
            <p>Have a project in mind, a wild idea, or want to talk AI and product development? The editor takes meetings over coffee.</p>
          </div>
          <div class="letters-actions">
            <a class="button" href={PROFILE.calendarUrl} target="_blank" rel="noopener noreferrer">Schedule a Chat</a>
            <a href={PROFILE.email}>Or send a letter by email</a>
          </div>
        </section>
      </main>

      <footer>
        <span>© {new Date().getFullYear()} The Mayes Dispatch</span>
        <span>
          <a href={PROFILE.social.github}>GitHub</a> · <a href={PROFILE.social.linkedin}>LinkedIn</a> ·
          <a href={PROFILE.social.twitter}>X</a> · <a href="/rss.xml">RSS</a>
        </span>
      </footer>
    </div>

    <DesignSwitcher slug="editorial" />
  </body>
</html>

<style>
  :global(*),
  :global(*::before),
  :global(*::after) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: #E9E2D4;
    color: #161412;
    font-family: 'Source Serif 4', Georgia, serif;
    font-size: 17px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: inherit;
  }

  .paper {
    max-width: 1180px;
    margin: 0 auto;
    padding: 20px 40px 96px;
    background: #F4EFE6;
    min-height: 100vh;
    box-shadow: 0 0 0 1px rgba(22, 20, 18, 0.06), 0 30px 80px rgba(22, 20, 18, 0.08);
  }

  .topline,
  .dateline,
  footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .topline nav {
    display: flex;
    gap: 18px;
  }

  .topline a,
  .dateline a,
  footer a {
    text-decoration: none;
  }

  .topline a:hover,
  .dateline a:hover,
  footer a:hover {
    color: #B3261E;
  }

  .masthead {
    text-align: center;
    padding: 28px 0 14px;
    border-bottom: 1px solid #161412;
  }

  .masthead h1 {
    margin: 0;
    font-family: 'Playfair Display', serif;
    font-weight: 900;
    font-size: clamp(2.6rem, 8.5vw, 6.5rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .masthead h1 a {
    text-decoration: none;
  }

  .motto {
    margin: 10px 0 0;
    font-style: italic;
    font-size: 15px;
    color: #57514A;
  }

  .dateline {
    border-top: 4px double #161412;
    border-bottom: 1px solid #161412;
    padding: 8px 0;
    margin-top: 3px;
  }

  .front {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: 40px;
    padding: 36px 0 12px;
  }

  .kicker {
    margin: 0 0 8px;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #B3261E;
  }

  .headline {
    margin: 0;
    font-family: 'Playfair Display', serif;
    font-weight: 900;
    font-size: clamp(2.4rem, 6vw, 4.6rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
  }

  .dek {
    margin: 16px 0 12px;
    font-size: 21px;
    line-height: 1.45;
    font-style: italic;
    color: #3A3530;
  }

  .byline {
    margin: 0 0 20px;
    padding-bottom: 16px;
    border-bottom: 1px solid #C9C0B0;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .lead-body {
    column-count: 2;
    column-gap: 32px;
    column-rule: 1px solid #D8CFBF;
  }

  .lead-body p {
    margin: 0 0 14px;
    text-align: justify;
    hyphens: auto;
  }

  .dropcap::first-letter {
    float: left;
    font-family: 'Playfair Display', serif;
    font-weight: 900;
    font-size: 4.4em;
    line-height: 0.82;
    padding: 6px 8px 0 0;
    color: #B3261E;
  }

  .lead-actions {
    break-inside: avoid;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-weight: 600;
  }

  .lead-actions a {
    text-decoration-color: #B3261E;
    text-underline-offset: 3px;
  }

  .front-rail {
    border-left: 1px solid #C9C0B0;
    padding-left: 32px;
  }

  .portrait {
    margin: 0 0 24px;
  }

  .portrait img {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    display: block;
    filter: grayscale(1) contrast(1.1);
  }

  .portrait figcaption {
    margin-top: 8px;
    font-size: 13px;
    font-style: italic;
    color: #57514A;
  }

  .numbers h3 {
    margin: 0 0 8px;
    padding-bottom: 6px;
    border-bottom: 2px solid #161412;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .numbers dl {
    margin: 0 0 16px;
  }

  .numbers dl div {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 8px 0;
    border-bottom: 1px solid #D8CFBF;
  }

  .numbers dt {
    font-size: 15px;
  }

  .numbers dd {
    margin: 0;
    font-family: 'Playfair Display', serif;
    font-weight: 900;
    font-size: 28px;
    line-height: 1;
  }

  .lang-list {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 14px;
  }

  .lang-list li {
    display: flex;
    gap: 6px;
    align-items: baseline;
  }

  .leader {
    flex: 1;
    border-bottom: 1px dotted #8A8278;
  }

  .section {
    margin-top: 48px;
  }

  .section-title {
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 0 0 24px;
    font-family: 'Playfair Display', serif;
    font-weight: 700;
    font-style: italic;
    font-size: 30px;
  }

  .section-title::before,
  .section-title::after {
    content: '';
    flex: 1;
    border-top: 1px solid #161412;
    border-bottom: 1px solid #161412;
    height: 4px;
  }

  .section-dek {
    text-align: center;
    margin: -12px 0 24px;
    font-style: italic;
    color: #57514A;
  }

  .feature-lead {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: 32px;
    align-items: center;
    padding-bottom: 28px;
    border-bottom: 1px solid #C9C0B0;
  }

  .feature-lead h3 {
    margin: 0 0 10px;
    font-family: 'Playfair Display', serif;
    font-weight: 900;
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    line-height: 1.1;
  }

  .feature-lead h3 a,
  .feature h3 a,
  .classifieds h3 a {
    text-decoration: none;
  }

  .feature-lead h3 a:hover,
  .feature h3 a:hover,
  .classifieds h3 a:hover {
    color: #B3261E;
  }

  .feature-pitch {
    margin: 0 0 8px;
    font-size: 19px;
  }

  .meta {
    margin: 0;
    font-size: 14px;
    font-style: italic;
    color: #57514A;
  }

  blockquote {
    margin: 0;
    padding: 20px 0;
    border-top: 3px solid #B3261E;
    border-bottom: 1px solid #161412;
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-weight: 700;
    font-size: 26px;
    line-height: 1.25;
    text-align: center;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .feature {
    padding: 24px 24px 20px;
    border-bottom: 1px solid #C9C0B0;
  }

  .feature:not(:nth-child(3n + 1)) {
    border-left: 1px solid #C9C0B0;
  }

  .feature:nth-child(3n + 1) {
    padding-left: 0;
  }

  .feature:nth-child(3n) {
    padding-right: 0;
  }

  .feature h3 {
    margin: 0 0 4px;
    font-family: 'Playfair Display', serif;
    font-weight: 900;
    font-size: 24px;
    line-height: 1.15;
  }

  .feature-tagline {
    margin: 0 0 8px;
    font-style: italic;
    color: #3A3530;
  }

  .feature p:last-child {
    margin: 0;
    font-size: 15px;
  }

  .classifieds {
    list-style: none;
    margin: 0;
    padding: 0;
    column-count: 3;
    column-gap: 28px;
    column-rule: 1px solid #D8CFBF;
  }

  .classifieds li {
    break-inside: avoid;
    padding: 0 0 14px;
    margin-bottom: 14px;
    border-bottom: 1px solid #D8CFBF;
    font-size: 14px;
    line-height: 1.5;
  }

  .classifieds time {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #B3261E;
  }

  .classifieds h3 {
    margin: 2px 0 4px;
    font-family: 'Playfair Display', serif;
    font-weight: 700;
    font-size: 18px;
  }

  .classifieds p {
    margin: 0 0 4px;
  }

  .lang {
    font-style: italic;
    color: #57514A;
  }

  .letters {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 32px;
    margin-top: 48px;
    padding: 28px 32px;
    border: 1px solid #161412;
    outline: 1px solid #161412;
    outline-offset: 4px;
  }

  .letters h2 {
    margin: 0 0 6px;
    font-family: 'Playfair Display', serif;
    font-weight: 900;
    font-size: 30px;
  }

  .letters p {
    margin: 0;
    max-width: 560px;
  }

  .letters-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
    font-size: 14px;
  }

  .button {
    display: inline-block;
    padding: 12px 22px;
    background: #161412;
    color: #F4EFE6;
    text-decoration: none;
    font-family: 'Inter', system-ui, sans-serif;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: background-color 0.15s ease;
  }

  .button:hover {
    background: #B3261E;
  }

  footer {
    margin-top: 48px;
    padding-top: 12px;
    border-top: 4px double #161412;
  }

  @media (max-width: 900px) {
    .paper {
      padding: 16px 16px 96px;
    }

    .front,
    .feature-lead {
      grid-template-columns: 1fr;
    }

    .front-rail {
      border-left: 0;
      padding-left: 0;
    }

    .portrait img {
      max-width: 320px;
    }

    .lead-body,
    .classifieds {
      column-count: 1;
    }

    .feature-grid {
      grid-template-columns: 1fr;
    }

    .feature,
    .feature:not(:nth-child(3n + 1)) {
      padding: 20px 0;
      border-left: 0;
    }

    .letters {
      flex-direction: column;
      align-items: flex-start;
      padding: 24px 20px;
    }

    .letters-actions {
      align-items: flex-start;
    }

    .topline-date {
      display: none;
    }
  }

  @media (min-width: 901px) and (max-width: 1100px) {
    .classifieds {
      column-count: 2;
    }
  }
</style>
