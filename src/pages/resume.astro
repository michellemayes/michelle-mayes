---
import OsPage from '../layouts/OsPage.astro';
import { SITE_TITLE } from '../consts';

export const prerender = true;
---

<OsPage
  title={`Resume | ${SITE_TITLE}`}
  description="Resume for Michelle Mayes — data scientist and AI product engineer building intelligent systems with RAG, LLMs, and modern web stacks."
  windowTitle="Resume.pdf"
  size="m"
>
  <div class="win-toolbar" slot="toolbar">
    <h1 class="doc-title">Resume <span>Michelle Mayes</span></h1>
    <span class="spacer"></span>
    <a class="mac-btn" href="/resume.pdf" target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 4h6v6M20 4l-9 9M18 14v6H4V6h6" /></svg>
      Open
    </a>
    <a class="mac-btn primary" href="/resume.pdf" download>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M5 20h14" /></svg>
      Download PDF
    </a>
  </div>

  <div class="canvas">
    <iframe src="/resume.pdf#view=FitH" title="Michelle Mayes Resume">
      <p>Unable to display the PDF here. <a href="/resume.pdf" download>Download the resume</a>.</p>
    </iframe>
    <p class="mobile-note">
      Phones only preview the first page. <a href="/resume.pdf" target="_blank" rel="noopener">Open the full PDF</a>.
    </p>
  </div>
</OsPage>

<style>
  .doc-title {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0;
    color: var(--os-ink);
  }

  .doc-title span {
    margin-left: 6px;
    font-weight: 500;
    color: var(--os-muted);
  }

  /* Gray canvas with the page floating on it, like Preview. */
  .canvas {
    padding: 24px;
    background: #E4E2EA;
  }

  iframe {
    display: block;
    width: 100%;
    height: max(70vh, 640px);
    border: 0;
    border-radius: 4px;
    background: #FFFFFF;
    box-shadow: 0 0 0 0.5px rgba(0, 0, 0, 0.1), 0 10px 30px rgba(31, 29, 43, 0.18);
  }

  .mobile-note {
    display: none;
    margin-top: 12px;
    font-size: 13px;
    text-align: center;
    color: var(--os-subtle);
  }

  @media (max-width: 760px) {
    .canvas {
      padding: 12px;
    }

    iframe {
      height: 70vh;
    }

    .mobile-note {
      display: block;
    }
  }
</style>
