---
import { Image } from 'astro:assets';
import Desktop from '../layouts/Desktop.astro';
import Window from '../components/Window.astro';
import { SITE_TITLE, SOCIAL_LINKS } from '../consts';
import aboutPhoto from '../../public/about-photo.jpg';

// Prerender this page as static
export const prerender = true;

const CALENDAR_URL = 'https://calendar.app.google/yYSHV4KQ4zJsxkdt5';

const details = [
	{ label: 'Based in', value: 'Austin, TX' },
	{ label: 'Background', value: 'Data Science, Policy, AdTech' },
	{ label: 'Builds', value: 'AI tools, web apps, Mac apps' },
	{ label: 'Works best with', value: 'High-velocity teams' },
];

const socials = [
	{ href: SOCIAL_LINKS.github, label: 'GitHub', glyph: 'M9 19c-4 1-4-2-6-2m12 4v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1-.3-3.4 1.3a11.6 11.6 0 0 0-6 0C6.8 2.8 5.8 3.1 5.8 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4.4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21' },
	{ href: SOCIAL_LINKS.linkedin, label: 'LinkedIn', glyph: 'M7 10v8M7 6.5v.01M11 18v-4.5a2.5 2.5 0 0 1 5 0V18M11 10v8' },
	{ href: SOCIAL_LINKS.twitter, label: 'X', glyph: 'M4 4l16 16M20 4L4 20' },
	{ href: SOCIAL_LINKS.email, label: 'Email', glyph: 'M4 6h16v12H4zM4 7l8 6 8-6' },
];
---

<Desktop
  title={`About - ${SITE_TITLE}`}
  description="Full-stack builder at the intersection of AI and product development, based in Austin, TX."
  appName="Contacts"
>
  <Window
    id="app-about"
    title="About Me"
    titleAs="p"
    route="/about"
    appName="Contacts"
    docTitle={`About - ${SITE_TITLE}`}
    width={1000}
    height={760}
    icon={{ color: 'linear-gradient(160deg, #F0ABFC, #A21CAF)', glyph: 'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-7 8a7 7 0 0 1 14 0' }}
    primary
    class="app-about"
  >
	<div class="card">
		<aside class="profile">
			<Image src={aboutPhoto} alt="Michelle Mayes" class="photo" width={160} height={160} loading="eager" />
			<h1 class="name">Michelle Mayes</h1>
			<p class="role">Full-Stack Builder &amp; AI Product Engineer</p>
			<div class="actions">
				<a class="mac-btn primary" href={CALENDAR_URL} target="_blank" rel="noopener noreferrer">Schedule a chat</a>
				<a class="mac-btn" href="/resume">Resume</a>
			</div>
			<ul class="socials" aria-label="Elsewhere">
				{socials.map((social) => (
					<li>
						<a
							href={social.href}
							aria-label={social.label}
							title={social.label}
							target={social.href.startsWith('http') ? '_blank' : undefined}
							rel={social.href.startsWith('http') ? 'noopener noreferrer' : undefined}
						>
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={social.glyph} /></svg>
						</a>
					</li>
				))}
			</ul>
		</aside>

		<div class="content">
			<section aria-labelledby="bio-title">
				<h2 class="os-section-title" id="bio-title">Bio</h2>
				<div class="os-group bio">
					<p>
						I build practical products at the intersection of AI and web development, with a strong bias toward shipping quickly and learning in public.
					</p>
					<p>
						My background spans Data Science, Policy, and AdTech, and I bring that product perspective into modern full-stack work: clear problem framing, fast iteration, and outcome-focused decisions.
					</p>
					<p>
						Right now I am focused on opportunities where I can build with high-velocity teams, improve developer workflows with AI, and share what works through writing and talks.
					</p>
				</div>
			</section>

			<section aria-labelledby="details-title">
				<h2 class="os-section-title" id="details-title">Details</h2>
				<dl class="os-group">
					{details.map((detail) => (
						<div class="os-group-row">
							<dt>{detail.label}</dt>
							<dd>{detail.value}</dd>
						</div>
					))}
				</dl>
			</section>

			<section aria-labelledby="activity-title">
				<h2 class="os-section-title" id="activity-title">GitHub activity</h2>
				<div class="os-group activity">
					<img
						src="https://ghchart.rshah.org/7C3AED/michellemayes"
						alt="Michelle Mayes's GitHub contribution calendar for the past year"
						loading="lazy"
						decoding="async"
						referrerpolicy="no-referrer"
					/>
				</div>
			</section>
		</div>
	</div>
  </Window>
</Desktop>
